#!/usr/bin/env zsh

os=`uname -s`
action="${1:-build}"
case "$action" in
    build|install) ;;
    *) print -u2 -- "Unknown action: $action"; exit 2 ;;
esac
# install is same script for both gnu and win
[[ "$action" == "install" ]] && {
	./build/install.sh || exit $?
	[[ "$os" == "Cygwin" ]] && {
		# fix pinentry w32 path
		ln -sf /usr/sbin/msmtp.exe /usr/bin/msmtp || exit $?
		ln -sf /usr/bin/neomutt.exe /usr/bin/mutt || exit $?
	}
	exit 0
}

case $os in
    CYGWIN*|Cygwin)
        print "Windows $action"
        ./build/${action}-win.sh
        ;;
    Linux)
        print "GNU/Linux $action"
        ./build/${action}-gnu.sh
        ;;
    OpenBSD|FreeBSD)
	print "$os $action"
        ./build/${action}-bsd.sh
	;;
    *) print -u2 -- "Unsupported build platform: $os"; exit 2 ;;
esac

