  "cache_contract": {
    "cache_version": 1,
    "policy_version": 1,
    "address_case": "ascii-mailbox-casemap-v1",
    "sieve_address_comparator": "i;ascii-casemap",
    "regex_dialect": "posix-ere-c-icase-v1",
    "metadata_field_count": 7
  },
  "import_examples": [
    {
      "id": "generated-exact-case-v1",
      "mode": "v1",
      "profile": "core-v1",
      "script": "require [\"fileinto\",\"mailbox\"];\nif true {}\nif true { if header :contains :comparator \"i;ascii-casemap\" \"Sender\" \"mailman-bounce\" { fileinto :create \"zz.bounces\"; stop; } }\nif true { if address :all :is :comparator \"i;ascii-casemap\" [\"From\",\"Sender\"] \"EXACT@EXAMPLE.ORG\" { fileinto :create \"exact\"; stop; } }\nif true {}\nif true {}\nif true { if header :is :comparator \"i;ascii-casemap\" \"X-Spam-Flag\" \"YES\" { fileinto :create \"Spam\"; stop; } }\nif true {}\nfileinto :create \"unsorted\";\n",
      "expected_exit": 0,
      "expected_rules": ["from-address exact@example.org move exact"]
    },
    {
      "id": "cross-address-condition-not-supported",
      "mode": "v1",
      "script": "if allof (address :localpart :is :comparator \"i;octet\" \"From\" \"Exact\", address :domain :is \"From\" \"example.org\") { fileinto \"exact\"; stop; }",
      "expected_exit": 4
    },
    {
      "id": "generated-domain-v1",
      "mode": "v1",
      "script": "require [\"fileinto\",\"mailbox\"];\nif true {}\nif true { if header :contains :comparator \"i;ascii-casemap\" \"Sender\" \"mailman-bounce\" { fileinto :create \"zz.bounces\"; stop; } }\nif true { if address :domain :is :comparator \"i;ascii-casemap\" [\"From\",\"Sender\"] \"vendor.example\" { fileinto :create \"vendors\"; stop; } }\nif true {}\nif true {}\nif true { if header :is :comparator \"i;ascii-casemap\" \"X-Spam-Flag\" \"YES\" { fileinto :create \"Spam\"; stop; } }\nif true {}\nfileinto :create \"unsorted\";\n",
      "expected_exit": 0,
      "expected_rules": [
        "from-domain vendor.example move vendors"
      ]
    },
    {
      "id": "legacy-requires-explicit-recovery",
      "mode": "v1",
      "script": "if header :contains [\"To\",\"Cc\"] \"team@example.org\" { fileinto :create \"team\"; stop; }",
      "expected_exit": 4
    },
    {
      "id": "legacy-recovery",
      "mode": "legacy-generated",
      "profile": "pigeonhole-2.4.5-posix-ere-v1",
      "precondition": "The recovered ERE is independently qualified by the selected installed profile; grammar recovery alone does not grant export support",
      "script": "require [\"fileinto\",\"mailbox\",\"variables\"];\nif header :contains [\"To\",\"Cc\"] \"team@example.org\" { fileinto :create \"team\"; stop; }\nfileinto :create \"unsorted\";",
      "expected_exit": 0,
      "expected_rules": [
        "to team@example.org move team"
      ],
      "migration_diagnostic": true
    },
    {
      "id": "redirect-not-supported",
