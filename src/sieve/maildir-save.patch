-	/* maildir spec says we should use link() + unlink() here. however
-	   since our filename is guaranteed to be unique, rename() works just
-	   as well, except faster. even if the filename wasn't unique, the
-	   problem could still happen if the file was already moved from
-	   new/ to cur/, so link() doesn't really provide any safety anyway.
-
-	   Besides the small temporary performance benefits, this rename() is
-	   almost required with OSX's HFS+ filesystem, since it implements
-	   hard links in a pretty ugly way, which makes the performance crawl
-	   when a lot of hard links are used. */
-	if (rename(tmp_path, new_path) == 0) {
-		mf->flags |= MAILDIR_FILENAME_FLAG_MOVED;
-		return 0;
-	} else if (ENOQUOTA(errno)) {
+	/* The source name may already exist. Keep an unrelated publication and
+	   retain our final name for Dovecot's uidlist, fsync and rollback. */
+	const char *mailbox = mailbox_get_vname(&ctx->mbox->box);
+	if (strcasecmp(mailbox, "INBOX") == 0)
+		mailbox = "INBOX";
+	for (unsigned int attempt = 0; attempt < 64; attempt++) {
+		if (jaro_sieve_publish(mailbox, mf->tmp_name, mf->local_name) == 0) {
+			mf->flags |= MAILDIR_FILENAME_FLAG_MOVED;
+			return 0;
+		}
+		if (errno != EEXIST || attempt == 63)
+			break;
+		const char *suffix = strstr(jaro_sieve_filename, ":2,");
+		if (suffix == NULL)
+			suffix = "";
+		errno = 0;
+		long limit = pathconf(ctx->curdir, _PC_NAME_MAX);
+		if (limit < 0 && errno != 0)
+			break;
+		size_t maximum = limit < 0 ? 255 : (size_t)limit;
+		if (strlen(suffix) >= maximum) {
+			errno = EEXIST;
+			break;
+		}
+		const char *fresh = t_strconcat("jaro.", maildir_filename_generate(), NULL);
+		if (strlen(fresh) > maximum - strlen(suffix)) {
+			/* Put the varying digit first when only a short stem fits. */
+			const char alphabet[] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+			fresh = t_strdup_printf("%c%s", alphabet[attempt % (sizeof(alphabet)-1)], fresh);
+			fresh = t_strndup(fresh, maximum - strlen(suffix));
+		}
+		mf->local_name = p_strconcat(ctx->pool, fresh, suffix, NULL);
+		new_path = t_strconcat(ctx->curdir, "/", mf->local_name, NULL);
+	}
+	if (ENOQUOTA(errno)) {
