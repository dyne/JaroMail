#!/usr/bin/python3 -I
"""Bind explicit Maildirs and an immutable local Sieve program for one process."""

import argparse
from contextlib import ExitStack
import hashlib
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile


class FilterError(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def directory(path, stack):
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise FilterError(2, f"expected an absolute directory: {path}")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    fd = os.open("/", flags)
    try:
        for component in path.parts[1:]:
            child = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = child
    except BaseException:
        os.close(fd)
        raise
    stack.callback(os.close, fd)
    return fd


def product(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError(f"expected a regular file: {path}")
        data = stream.read(limit + 1)
        if len(data) > limit:
            raise ValueError(f"file too large: {path}")
        return data


def snapshot(script, home, runtime, runtime_id, generation):
    # Resolve the directory once, including a published generation symlink.
    try:
        parent = script.parent.resolve(strict=True)
        source = product(parent / script.name, 128 << 20)
    except (FileNotFoundError, ValueError) as error:
        if generation:
            raise FilterError(5, "selected generation is incomplete; run jaro fresh-filters") from error
        raise
    (home / "script").write_bytes(source)
    if not (script.name == "Filters.sieve"
            and parent.parts[-4:-1] == ("cache", "filter-engine", "generations")
            and re.fullmatch("[0-9a-f]{64}", parent.name)):
        if generation:
            raise FilterError(5, "workflow requires a pinned Sieve generation; run jaro fresh-filters")
        return False
    if generation and generation != parent.name:
        raise FilterError(5, "selected Sieve generation changed; run jaro fresh-filters")
    extra = [home / "provenance"] if generation else []
    with (home / "binary").open("xb") as binary:
        result = subprocess.run([runtime.parent / "bin/sieve-generation-read", parent.parents[3],
                        parent.name, hashlib.sha256(source).hexdigest(), runtime_id, *extra],
                       stdout=binary)
        if result.returncode:
            raise FilterError(5, "cannot load selected generation; run jaro fresh-filters")
    return True


def identity(st):
    return st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns


def source_entries(dirs, selected, *, limit=None):
    entries = []
    for folder in ("cur", "new"):
        if selected and folder != selected[0]:
            continue
        if selected:
            names = [selected[1]]
        else:
            names = []
            with os.scandir(dirs[folder]) as children:
                for child in children:
                    if child.name.startswith("."):
                        continue
                    if limit is not None and len(entries) + len(names) >= limit:
                        raise FilterError(2, f"batch exceeds the {limit}-message workflow limit")
                    names.append(child.name)
            names.sort(key=os.fsencode)
        for name in names:
            st = os.stat(name, dir_fd=dirs[folder], follow_symlinks=False)
            if not stat.S_ISREG(st.st_mode):
                raise ValueError(f"expected a regular Maildir message: {folder}/{name}")
            # Dovecot identifies mail by basename before :2,. Give every
            # physical occurrence its own UID even across duplicate names.
            entries.append((folder, name, str(len(entries)), identity(st)))
    return entries


def restore(claim_fd, key, directory, name):
    # Never replace mail delivered under the original name during this batch.
    os.link(key, name, src_dir_fd=claim_fd, dst_dir_fd=directory, follow_symlinks=False)
    os.fsync(directory)
    os.unlink(key, dir_fd=claim_fd)


def worker_status(status):
    if status < 0:
        return 128 - status
    if status in (0, 2, 3, 4, 5, 6, 7, 127) or 128 < status < 128 + signal.NSIG:
        return status
    return 3


def run_batch(command, env, home, source, dirs, fds, preview, entries):
    tmp = Path(f"/proc/self/fd/{dirs['tmp']}")
    work = home / "preview" if preview else tmp / ".jaro-sieve-transaction"
    read_fd, write_fd = os.pipe()
    try:
        worker = subprocess.Popen([*command, str(write_fd)], env=env, cwd=home,
                                  pass_fds=(*fds, *dirs.values(), write_fd), stdin=subprocess.PIPE)
    finally:
        os.close(write_fd)
    handles = ExitStack()
    work_fd = None
    stages = {}
    failed = False
    claimed = []
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        with os.fdopen(read_fd, "rb") as ready:
            if ready.read(1) != b"R":
                return worker_status(worker.wait()) or 3
        try:
            work.mkdir(mode=0o700)
        except FileExistsError:
            raise ValueError(f"unfinished Maildir transaction: inspect {source / 'tmp' / work.name}")
        work_fd = os.open(work, flags)
        handles.callback(os.close, work_fd)
        work_stat = os.fstat(work_fd)
        (home / "batch-identity").write_text(f"{work_stat.st_dev} {work_stat.st_ino}\n")
        for child in ("cur", "new", "tmp"):
            os.mkdir(child, mode=0o700, dir_fd=work_fd)
            stages[child] = os.open(child, flags, dir_fd=work_fd)
            handles.callback(os.close, stages[child])
        (home / "batch").symlink_to(work)
        inventory_fd = os.open("inventory.jsonl", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600, dir_fd=work_fd)
        with (home / "names").open("wb") as names, os.fdopen(inventory_fd, "w") as inventory:
            for folder, name, key, expected in entries:
                dev, ino, size, mtime = expected
                names.write(os.fsencode(name) + b"\0")
                names.write(f"{dev} {ino} {size} {mtime // 1000000000} {mtime % 1000000000}\n".encode())
                inventory.write(json.dumps([key, folder, name, expected]) + "\n")
            inventory.flush()
            os.fsync(inventory.fileno())
        os.fsync(work_fd)
        if not preview:
            os.fsync(dirs["tmp"])
        for folder, name, key, expected in entries:
            try:
                if preview:
                    os.symlink(f"/proc/self/fd/{dirs[folder]}/{name}", key, dir_fd=stages["cur"])
                else:
                    os.rename(name, key, src_dir_fd=dirs[folder], dst_dir_fd=stages["cur"])
                    claimed.append(("cur", key, folder, name))
            except OSError as error:
                print(f"jaro-sieve-filter: {error}", file=sys.stderr)
                failed = True
                continue
            try:
                info = os.stat(key, dir_fd=stages["cur"], follow_symlinks=preview)
                if not stat.S_ISREG(info.st_mode) or identity(info) != expected:
                    raise ValueError(f"changed source: {folder}/{name}")
            except (OSError, ValueError) as error:
                print(f"jaro-sieve-filter: {error}", file=sys.stderr)
                failed = True
                if preview:
                    os.unlink(key, dir_fd=stages["cur"])
                else:
                    os.rename(key, key, src_dir_fd=stages["cur"], dst_dir_fd=stages["tmp"])
                    claimed[-1] = ("tmp", key, folder, name)
        if not preview:
            for fd in (stages["cur"], stages["tmp"], dirs["cur"], dirs["new"]):
                os.fsync(fd)
        worker.stdin.write(b"G")
        worker.stdin.close()
        status = worker.wait()
    finally:
        if worker.poll() is None:
            worker.terminate()
            worker.wait()
        if not worker.stdin.closed:
            worker.stdin.close()
        try:
            for stage, key, folder, name in claimed:
                try:
                    restore(stages[stage], key, dirs[folder], name)
                except FileNotFoundError:
                    pass  # Dovecot expunged this occurrence after delivering it.
                except OSError as error:
                    failed = True
                    retained = source / "tmp" / work.name / stage / key
                    print(f"jaro-sieve-filter: {error}; retained {retained}", file=sys.stderr)
            if work_fd is not None and not preview and not any(os.listdir(fd) for fd in stages.values()):
                if os.path.samestat(os.fstat(work_fd), work.lstat()):
                    try:
                        os.unlink("inventory.jsonl", dir_fd=work_fd)
                    except FileNotFoundError:
                        pass
                    for sub in stages:
                        os.rmdir(sub, dir_fd=work_fd)
                    work.rmdir()
                    os.fsync(dirs["tmp"])
        finally:
            handles.close()
    return worker_status(status) or (7 if failed else 0)


def records(path):
    data = path.read_bytes().split(b"\0")
    if data.pop() or len(data) % 4:
        raise ValueError(f"incomplete Sieve {path.name}")
    return zip(*[iter(data)] * 4)


def report(home, entries, source, base, args, source_box):
    provenance = {int(line): (rule, path, authored)
                  for line, rule, path, authored in records(home / "provenance")}
    decisions = {int(index): (int(status), location, mailbox)
                 for index, status, location, mailbox in records(home / "decisions")}
    output = sys.stdout.buffer
    output.write(b"JFD1\0" + args.report0.encode("ascii") + b"\0")
    for index, (folder, name, _, _) in enumerate(entries):
        path = args.message or source / folder / name
        status, location, mailbox = decisions.get(index, (-1, b"", b""))
        line = re.search(rb"(?:^|: )line ([0-9]+)$", location)
        winner = provenance.get(int(line[1])) if line else None
        rule, origin, authored = winner or (b"", b"", b"0")
        if status < 0:
            action = [b"none", b"", b"", b"", b"error", origin, authored, b"E_SIEVE_DELIVERY"]
        else:
            if not winner or not mailbox:
                raise ValueError(f"missing Sieve action provenance at {location!r}")
            if mailbox.upper() == b"INBOX":
                mailbox = b"INBOX"
            noop = mailbox == os.fsencode(source_box)
            outcome = b"noop" if noop else b"classified" if args.dry_run else b"moved"
            action = [b"none" if noop else b"move", mailbox, os.fsencode(base / os.fsdecode(mailbox)),
                      mailbox, outcome, origin, authored, b""]
        output.write(b"\0".join([str(index + 1).encode(), os.fsencode(path), rule, *action]) + b"\0")


def lock_workflow(base_fd, stack):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    cache = os.open("cache", flags, dir_fd=base_fd)
    stack.callback(os.close, cache)
    engine = os.open("filter-engine", flags, dir_fd=cache)
    stack.callback(os.close, engine)
    fd = os.open("batch.lock", os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CREAT,
                 0o600, dir_fd=engine)
    stack.callback(os.close, fd)
    st = os.fstat(fd)
    if (not stat.S_ISREG(st.st_mode) or stat.S_IMODE(st.st_mode) != 0o600
            or st.st_uid != os.geteuid() or st.st_nlink != 1):
        raise ValueError("invalid workflow batch.lock")
    fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    if not os.path.samestat(st, os.stat("batch.lock", dir_fd=engine, follow_symlinks=False)):
        raise FilterError(6, "workflow batch.lock changed")


def main():
    parser = argparse.ArgumentParser(prog="jaro-sieve-filter")
    parser.add_argument("--from", required=True, dest="incoming")
    parser.add_argument("--to", required=True, dest="base")
    parser.add_argument("--dry-run", action="store_true",
                        help="preview each message against the existing mailboxes; simulated saves do not create folders")
    parser.add_argument("--report0", metavar="GENERATION")
    parser.add_argument("--preview-provenance", type=Path,
                        help="compiler provenance for a standalone read-only candidate report")
    parser.add_argument("--message", type=Path)
    parser.add_argument("script", type=Path)
    args = parser.parse_args()
    runtime = Path(__file__).resolve().parent
    runtime_id = subprocess.check_output([runtime / "run", "identity"], text=True).split()[0]
    source, base = Path(args.incoming), Path(args.base)
    with ExitStack() as roots, tempfile.TemporaryDirectory(prefix="jaro-sieve-") as temporary:
        home = Path(temporary).resolve()
        selected = None
        if args.message:
            if not args.dry_run or not args.message.is_absolute():
                parser.error("--message requires --dry-run and an absolute path")
            if args.message.parent.parent == source and args.message.parent.name in ("cur", "new"):
                selected = (args.message.parent.name, args.message.name)
            elif args.message.parent == source:
                parent = directory(source, roots)
                fd = os.open(args.message.name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=parent)
                with os.fdopen(fd, "rb") as original:
                    before = os.fstat(fd)
                    if not stat.S_ISREG(before.st_mode):
                        raise ValueError("expected a regular saved message")
                    source = home / "saved"
                    for name in ("new", "cur", "tmp"):
                        (source / name).mkdir(parents=True)
                    with (source / "new/message").open("xb") as copy:
                        shutil.copyfileobj(original, copy)
                    if identity(before) != identity(os.fstat(fd)):
                        raise FilterError(6, "saved message changed during explain")
                selected = ("new", "message")
            else:
                parser.error("selected message must belong to --from")
        source_fd, base_fd = directory(source, roots), directory(base, roots)
        dirs = {}
        fcntl.flock(source_fd, (fcntl.LOCK_SH if args.dry_run else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        for name in ("cur", "new", "tmp"):
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=source_fd)
            roots.callback(os.close, fd)
            dirs[name] = fd
        candidate = args.preview_provenance is not None
        if candidate and not (args.dry_run and args.report0 and re.fullmatch("[0-9a-f]{64}", args.report0)):
            parser.error("candidate provenance requires a dry-run report")
        if args.report0 and not candidate and args.script != base / "cache/filter-engine/generations" / args.report0 / "Filters.sieve":
            raise FilterError(5, "workflow policy must belong to its selected mail root")
        cached = snapshot(args.script, home, runtime, runtime_id, None if candidate else args.report0)
        if candidate:
            (home / "provenance").write_bytes(product(args.preview_provenance, 128 << 20))
        if args.report0 and not args.dry_run:
            lock_workflow(base_fd, roots)
        (home / "incoming").mkdir()
        (home / "incoming/mail").symlink_to(f"/proc/self/fd/{source_fd}")
        (home / "folders").symlink_to(f"/proc/self/fd/{base_fd}")
        # A source already visible in the destination namespace must have the
        # same Dovecot identity when fileinto names that very mailbox.
        source_box = ".jaro-source/mail"
        if source != base and base in source.parents:
            relative = source.relative_to(base)
            if (relative.parts[0] != ".jaro-source" and
                    (str(relative).upper() != "INBOX" or str(relative) == "INBOX")):
                source_box = str(relative)
        mode = "preview" if args.dry_run else "apply"
        command = [runtime / "bin/doveconf", "-c", runtime / "maildir.conf", "-F",
                   runtime / "bin/maildir-filter", "--", source_box,
                   mode + ("-report" if args.report0 else ""), "cached" if cached else "source"]
        env = {"PATH": "/usr/bin:/bin", "USER": pwd.getpwuid(os.geteuid()).pw_name,
               "HOME": str(home), "LD_LIBRARY_PATH": str(runtime / "lib"),
               "CONFIG_MODULES": str(runtime / "lib/libpigeonhole_settings.so")}
        entries = source_entries(dirs, selected, limit=100_000 if args.report0 else None)
        status = run_batch(command, env, home, source, dirs, (source_fd, base_fd), args.dry_run, entries)
        if args.report0 and (home / "decisions").exists():
            report(home, entries, source, base, args, source_box)
        return status


if __name__ == "__main__":
    def interrupt(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, interrupt)
    try:
        sys.exit(main())
    except FilterError as error:
        print(f"jaro-sieve-filter: {error}", file=sys.stderr)
        sys.exit(error.status)
    except BlockingIOError as error:
        print(f"jaro-sieve-filter: batch locked: {error}", file=sys.stderr)
        sys.exit(6)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"jaro-sieve-filter: {error}", file=sys.stderr)
        sys.exit(3)
