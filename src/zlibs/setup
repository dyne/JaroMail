#!/usr/bin/env zsh

cmd_init() {
    init_inbox
    nm_setup
    read_account
    mblaze_setup
    if [[ -r "$MAILDIRS/.envrc" ]]; then
        warning "Cannot overwrite direnv conf: $MAILDIRS/.envrc"
        warning "Delete it manually if desired."
    else
        cat <<EOF > "$MAILDIRS/.envrc"
export JAROMAILDIR=$MAILDIRS
export JAROWORKDIR=/usr/local/share/jaromail
export NOTMUCH_CONFIG=$MAILDIRS/notmuch-config
export MBLAZE=$MAILDIRS/.mblaze
EOF
    fi
    command -v direnv >/dev/null || {
        direnv allow
        act "direnv configuration in .envrc"
    }
    notice "Initialization completed in $MAILDIRS"
}

cmd_update() {
    [[ "$option_params" = "" ]] || {
        for p in "${option_params[@]}"; do
            [[ "$p" = "." ]] && p=$PWD
            [[ -d $p ]] && MAILDIRS=$p
        done
    }
    ACCOUNTS=${JAROACCOUNT:-"$MAILDIRS/Accounts"}
    read_account || return $?
    mblaze_setup || return $?
    update_filters || return $?
    update_sieve || return $?
    [[ $DRYRUN == 1 ]] || update_notmuch || return $?
    notice "Initialization completed in $MAILDIRS"
}

cmd_sieve() {
    read_account || return $?
    mblaze_setup || return $?
    update_filters || return $?
    update_sieve || return $?
    notice "Sieve filters updated in $MAILDIRS"
}

cmd_sieve_import() {
    (( ${#option_params} == 1 )) || { error "sieve-import requires one generated Sieve file"; return 2; }
    filter_engine || return $?
    if [[ "$REPLY" == native ]]; then
        local -a import_args
        import_args=()
        option.is_set -L && import_args+=(--legacy-generated)
        [[ $DRYRUN == 1 ]] && import_args+=(--check)
        "$WORKDIR/bin/jaro-filter-compile" --root "$MAILDIRS" --accounts-dir "$ACCOUNTS" --import-sieve "${option_params[1]}" "${import_args[@]}"
        return $?
    fi
    option.is_set -L && { error "--legacy-generated requires JARO_FILTER_ENGINE=native"; return 2; }
    [[ $DRYRUN == 1 ]] && { error "Legacy sieve-import has no dry-run; select native bounded import"; return 2; }
    sieve_import ${option_params}
    exitcode=$?
}
