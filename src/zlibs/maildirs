# static global variable formail cache (used by rmdupes)
typeset -h formail_cache


# checks if its a maildir
# returns 0 (success) if yes
# no in all other cases
maildircheck() {
	fn maildircheck $*

    { test -r "$1" } || {
        func "Maildir not existing: $1"
        return 1 }
    { test -w "$1" } || {
        error "Directory not writable: $1"
        return 1 }
    { test -r "$1/cur" } \
        && { return 0 } # Yes is a maildir
    # shortened test to speedup
    #	&& { test -r $1/new } \
    #	&& { test -r $1/tmp } \
    func "Not a maildir: $1"
    return 1
}

maildirmake() {
	fn maildirmake $*

    (( $# )) || { error "missing Maildir path"; return 255; }
    local folder rc=0
    for folder in "$@"; do
        [[ -n "$folder" ]] || { error "empty Maildir path"; return 255; }
    done
    if command -v mmkdir >/dev/null; then
        mmkdir "$@"
        return $?
    fi

    for folder in "$@"; do
        if [[ -d "$folder/new" ]]; then
            continue
        elif [[ -e "$folder" ]]; then
            error "Cannot create Maildir: $folder"
            rc=254
        else
            ${=mkdir} "$folder/cur" "$folder/new" "$folder/tmp" || rc=$?
        fi
    done
    return $rc
}

# List message files from a Maildir.
# Uses mblaze when present; fallback scans only cur/new.
maildir_list_messages() {
    fn maildir_list_messages $*
    local md="$1"
    req=(md)
    ckreq || return 1

    maildircheck "$md" || return 1

    if command -v mlist >/dev/null; then
        mlist "$md"
        return $?
    fi

    ${=find} "$md/new" "$md/cur" -type f
}

# List top-level folder candidates under a root path.
# Uses mdirs when present and keeps direct children only.
maildir_list_folders() {
    fn maildir_list_folders $*
    local root="$1"
    req=(root)
    ckreq || return 1

    [[ -d "$root" ]] || return 1

    root=${root:a}
    if command -v mdirs >/dev/null; then
        local folders folder
        folders="$(mdirs -0 -a "$root")" || return $?
        for folder in "${(@0)folders}"; do
            [[ -n "$folder" && "${folder:h}" == "$root" ]] && print -rN -- "$folder"
        done
        return 0
    fi

    ${=find} "$root" -mindepth 1 -maxdepth 1 -type d -print0
}

# Move or copy one message into a destination Maildir.
# Third argument can be "copy"; default is move.
maildir_refile() {
    fn maildir_refile $*
    local msg="$1"
    local dest="$2"
    local mode="${3:-move}"
    req=(msg dest)
    ckreq || return 1

    [[ -r "$msg" ]] || return 1

    maildircheck "$dest" || maildirmake "$dest" || return 1

    if command -v mrefile >/dev/null; then
        msg=${msg:a}
        dest=${dest:a}
        [[ -f "$msg" && ! -L "$msg" ]] || return 1
        local published
        local -a opts=(-v)
        [[ "$mode" == copy ]] && opts+=(-k)
        # mrefile can exit zero after a failed item. Hold the original inode
        # open to verify a rename or compare a cross-device copy before removal.
        {
            published="$(mrefile "${opts[@]}" "$msg" "$dest" && print -rn -- .)" || return 1
            [[ "$published" == *$'\n.' ]] || return 1
            published=${published%$'\n.'}
            [[ "${published:h}" == "$dest/cur" && -f "$published" && ! -L "$published" ]] || return 1
            if [[ "$published" -ef /dev/fd/0 ]]; then
                [[ "$mode" == move && ! "$msg" -ef /dev/fd/0 ]]
                return $?
            fi
            cmp -s -- "$published" - || return 1
            [[ "$msg" -ef /dev/fd/0 ]] || return 1
            [[ "$mode" == copy ]] || command rm -- "$msg" || return 1
            return 0
        } < "$msg"
    fi

    # Keep Maildir flags while assigning a fresh, collision-safe basename.
    local flags=""
    [[ "${msg:t}" == *:2,* ]] && flags=":2,${${msg:t}#*:2,}"
    maildir_store "$dest" cur "$flags" < "$msg" || return 1
    [[ "$mode" == "copy" ]] || command rm -- "$msg" || return 1
    return 0
}

# Stage a complete message in tmp, then publish without replacing any file.
# Hard-link publication is atomic and stays on the destination filesystem.
maildir_store() {
    local dest="$1" subdir="${2:-new}" flags="${3:-}"
    local staged published result=1
    staged="$(mktemp "$dest/tmp/jaro.XXXXXXXXXX")" || return 1
    published="$dest/$subdir/${staged:t}${flags}"
    {
        if cat > "$staged" && command ln "$staged" "$published"; then
            last_deliver="$published"
            result=0
        fi
    } always {
        command rm -f -- "$staged" || result=1
    }
    return $result
}


# fills up all maildirs array
list_maildirs() {
	fn list_maildirs $*
    maildirs=()
    local folders m
    folders="$(maildir_list_folders "$MAILDIRS")" || return $?
    for m in "${(@0)folders}"; do
        [[ -n "$m" ]] || continue
        func "$m"
        maildircheck "$m" || continue
        [[ -n "$(maildir_list_messages "$m")" ]] || continue
        maildirs+=("${m:t}")
    done
    return ${#maildirs}
}


rmdupes() {
	fn rmdupes $*

    ## special argument lastlog
    { test "$1" = "lastlog" } && {
        lastdirs=(`maildirs_lastlog`)
        act "Pruning duplicates across ${#lastdirs} destination maildirs:"
        act "${lastdirs}"
        # recursion here
        rmdupes ${=lastdirs}
        notice "Done pruning"
        # all the prioritization above is so that duplicates are spotted
        # across different maildirs and deleted from the filtered source
        return 0
    }
    ###############
    
    tot=0
    typeset -al msgs
    
    ztmp
    formail_cache=$ztmpfile
    
    for folder in ${=@}; do
        { test -r "$folder" } || { folder="$MAILDIRS/$folder" }
        { test -r "$folder" } || {
            error "Directory not found: $folder"
            continue }
        
        { maildircheck "${folder}" } || {
            error "Not a maildir folder: $folder"
            continue }
        
        c=0
        notice "Checking for duplicates in $folder"
        msgs=`${=find} "${folder}" -maxdepth 2 -type f`
        act "Please wait, this can take a while..."
        
        
        
        for m in ${(f)msgs}; do
            func "formail < $m"
            # 128MB should be enough ehre?
            formail -D 128000000  "$formail_cache" <"$m" \
                && rm "$m" && c=$(( $c + 1 ))
        done
        act "$c duplicates found and deleted"
        tot=$(( $tot + $c ))
    done
    
    if [ "$tot" = "0" ]; then
        act "No duplicates found at all"
    else
        act "$tot total duplicates found and deleted"
    fi
}

# LDA delivery to a maildir
# important to return 1 on all errors
# so that fetchmail does not deletes mail from server
deliver() {
	fn deliver $*
    # default destination is incoming
    dest=${1:-incoming}

    # create destination maildir if not existing
    maildirmake "$MAILDIRS/$dest"
	[[ $? = 0 ]] || {
        error "Could not deliver email file into maildir $dest"
        func "Returning error to caller."
		sleep 3
        return 1
    }

	# use mblaze if found
    command -v mdeliver > /dev/null && {
		last_deliver=`mdeliver -v "$MAILDIRS/$dest"`
		local ret=$?
		[[ $ret == 0 ]] || {
			error "Deliver error (mblaze $ret) to maildir $dest"
			sleep 3
		}
		return $ret
	}

    # no tag specified, plain delivery without indexing
    ## destinations excluded from notmuch indexing
    # for indexing rules see filter_maildir()
    maildir_store "$MAILDIRS/$dest"
    [[ $? = 0 ]] || {
        error "Could not deliver email file into maildir $dest"
        func "Returning error to caller."
        return 1
    }
    return 0
}

cmd_remember() {
    deliver remember
    exitcode=$?
}

cmd_mkdir() {
    DEBUG=1 maildirmake ${option_params}
    exitcode=$?
}

cmd_rmdupes() {
    rmdupes ${option_params}
}

cmd_deliver() {
    deliver ${option_params}
    exitcode=$?
}

cmd_ismd() {
    maildircheck ${option_params}
    [[ $? = 0 ]] && \
        notice "Directory is a maildir: ${option_params}"
    exitcode=$?
}
