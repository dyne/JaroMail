new_account() {
	fn new_account $*
	acct=$1
	req=(acct)
	ckreq || return 1

	[[ -r $ACCOUNTS/$acct ]] && {
		error "account already existing: $ACCOUNTS/$acct"
		return 1 }

	isemail $acct || {
		error "new account is not an email: $acct"
		return 1 }


	name=${acct%%@*}
	domain=${acct##*@}
	local options
	case $domain in
		gmail.com)
			imap=imap.gmail.com
			smtp=smtp.gmail.com
			auth=plain
			cert=check
			options=keep
			;;
		*)
			imap=mail.${domain}
			smtp=mail.${domain}
			auth=plain
			cert=check
			options=keep
			;;
	esac
	cat <<EOF > $ACCOUNTS/$acct
# automatically generated by 'jaro wizard' for account: $acct
# modifications will not be overwritten
name $name
email $acct
login $acct
proto imap
host $imap
smtp $smtp
auth $auth
cert $cert
options $options
EOF
	act "account succesfully generated for $acct"
	return 1
}

_wizard_prompt() {
    # Prompt on tty/stderr and read a single line from stdin for scripted tests.
    _prompt="$1"
    print -n -- "${_prompt}" >&2
    IFS= read -r _answer || _answer=""
    print -- "${_answer}"
}

_wizard_yesno() {
    # Accept y/yes or n/no, fallback to default on empty input.
    _prompt="$1"
    _default="$2"
    while true; do
        _answer="$(_wizard_prompt "${_prompt}")"
        _answer="${_answer:l}"
        case "${_answer}" in
            y|yes) return 0 ;;
            n|no) return 1 ;;
            "")
                [[ "${_default}" = "y" ]] && return 0
                return 1
                ;;
            *)
                warning "Please answer y or n."
                ;;
        esac
    done
}

_wizard_ensure_pass_ready() {
    [[ "$PASS" = "1" ]] || return 0
    [[ -f "$PASSWORD_STORE_DIR/.gpg-id" ]] && return 0

    act "pass keyring detected but not initialized: $PASSWORD_STORE_DIR"

    _gpg_id=""
    if [[ -r "$HOME/.gnupg/gpg.conf" ]]; then
        _gpg_id="$(awk '/^default-key/ { print $2; exit }' "$HOME/.gnupg/gpg.conf")"
    fi
    [[ -n "${_gpg_id}" ]] || _gpg_id="$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^sec:/ { print $5; exit }')"

    if [[ -z "${_gpg_id}" ]]; then
        if [[ ! -t 0 ]]; then
            warning "No default GPG secret key found; skipping pass initialization in non-interactive mode."
            return 0
        fi
        notice "No default GPG secret key found. Creating one now."
        gpg --full-generate-key || {
            error "GPG key generation failed."
            return 1
        }
        _gpg_id="$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^sec:/ { print $5; exit }')"
        [[ -n "${_gpg_id}" ]] || {
            error "No secret key available after generation."
            return 1
        }
    fi

    act "Initializing pass store with GPG key: ${_gpg_id}"
    pass init "${_gpg_id}" || {
        error "pass init failed."
        return 1
    }
    return 0
}

_wizard_check_port() {
    _host="$1"
    _port="$2"
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 3 "${_host}" "${_port}" >/dev/null 2>&1
        return $?
    fi
    warning "Cannot validate ${_host}:${_port} reachability (missing nc)."
    return 2
}

account_wizard() {
    fn account_wizard
    act "Account setup wizard"
    act "Collecting account identity"

    while true; do
        acct="$(_wizard_prompt "Email address: ")"
        isemail "$acct" && break
        warning "Please insert a valid email address."
    done

    [[ -r "$ACCOUNTS/$acct" ]] && {
        error "account already existing: $ACCOUNTS/$acct"
        return 1
    }

    localpart="${acct%%@*}"
    domain="${acct##*@}"
    name_default="${localpart}"
    imap_default="mail.${domain}"
    smtp_default="mail.${domain}"

    name="$(_wizard_prompt "Display name [${name_default}]: ")"
    name="${name:-$name_default}"
    login="$(_wizard_prompt "Login [${acct}]: ")"
    login="${login:-$acct}"
    imap="$(_wizard_prompt "IMAP host [${imap_default}]: ")"
    imap="${imap:-$imap_default}"
    imap_port="$(_wizard_prompt "IMAP port [993]: ")"
    imap_port="${imap_port:-993}"
    smtp="$(_wizard_prompt "SMTP host [${smtp_default}]: ")"
    smtp="${smtp:-$smtp_default}"
    smtp_port="$(_wizard_prompt "SMTP port [587]: ")"
    smtp_port="${smtp_port:-587}"

    [[ "$imap_port" -regex-match '^[0-9]+$' ]] || {
        error "Invalid IMAP port: $imap_port"
        return 1
    }
    [[ "$smtp_port" -regex-match '^[0-9]+$' ]] || {
        error "Invalid SMTP port: $smtp_port"
        return 1
    }

    if _wizard_yesno "Check IMAP reachability (${imap}:${imap_port}) now? [y/N] " "n"; then
        act "Checking IMAP reachability..."
        _wizard_check_port "$imap" "$imap_port"
        case $? in
            0) notice "IMAP host reachable." ;;
            1) warning "IMAP host not reachable." ;;
            *) ;;
        esac
    fi

    if _wizard_yesno "Check SMTP reachability (${smtp}:${smtp_port}) now? [y/N] " "n"; then
        act "Checking SMTP reachability..."
        _wizard_check_port "$smtp" "$smtp_port"
        case $? in
            0) notice "SMTP host reachable." ;;
            1) warning "SMTP host not reachable." ;;
            *) ;;
        esac
    fi

    print >&2
    act "Account summary"
    print -- "name=${name}" >&2
    print -- "email=${acct}" >&2
    print -- "login=${login}" >&2
    print -- "imap=${imap}:${imap_port}" >&2
    print -- "smtp=${smtp}:${smtp_port}" >&2

    _wizard_yesno "Write account file now? [Y/n] " "y" || {
        warning "Wizard aborted, nothing written."
        return 1
    }

    [[ -d "$ACCOUNTS" ]] || ${=mkdir} "$ACCOUNTS"

    cat <<EOF > "$ACCOUNTS/$acct"
# automatically generated by 'jaro wizard' for account: $acct
# modifications will not be overwritten
name $name
email $acct
login $login
proto imap
imap $imap
imap_port $imap_port
smtp $smtp
smtp_port $smtp_port
auth plain
cert check
transport TLS1
options keep
exclude zz.spam zz.bounces zz.blacklist zz.social
my_hdr From: $name <$acct>
EOF

    account="$acct"
    host="$imap"
    email="$acct"
    _wizard_ensure_pass_ready || return 1

    act "Account configuration saved: $ACCOUNTS/$acct"
    notice "Use 'jaro -a $acct passwd' to store credentials."
    return 0
}

# -a defines which account name other than 'default'
# results in the definition of global account variables:
# name login host protocol port auth folders accountopt
read_account() {
    typeset -al all
    unset name email imap imap_port smtp smtp_port proto \
        host login transport auth cert options folders exclude
    # parse arguments

    [[ "$account" = "" ]] && account="default"

    # find the account
    func "read_account looking for $account"
    acct="$ACCOUNTS/$account";
    { test -r "$acct" } || {
        acct="$ACCOUNTS/${account}.txt"
        { test -r "$acct" } || {
            error "no account found: $acct"
            act "Refine your argument using '-a accountname'"
            act "Available accounts:"
            ls "$ACCOUNTS/"
            return 1
        }
    }

    ttmp=`awk '
	/^my_hdr/ { next }
    /^#/ { next }
    /^name/ { printf "name=\""; for(i=2;i<=NF;i++) printf "%s ", $i; printf "\";" }
    /^email/ { printf "email=\"%s\";", $2 }
	/^proto/ { printf "proto=\"%s\";", $2 }
    /^imap / { printf "imap=\"%s\";", $2 }
    /^smtp / { printf "smtp=\"%s\";", $2 }
    /^host / { printf "host=\"%s\";", $2 }
    /^port / { printf "port=\"%s\";", $2 }
    /^login/ { printf "login=\"%s\";", $2 }
    /^transport/ { printf "transport=\"%s\";", $2 }
    /^certfile/ { printf "certfile=\"%s\";", $2 }
    /^imap_port/ { printf "imap_port=\"%s\";", $2 }
    /^smtp_port/ { printf "smtp_port=\"%s\";", $2 }
    /^auth/ { printf "auth=\"%s\";", $2 }
    /^cert/ { printf "cert=\"%s\";", $2 }
    /^password/ { printf "password=\"%s\";", $2 }
    /^options/ { printf "accountopt=\""; for(i=2;i<=NF;i++) printf "%s ", $i; printf "\";" }
    /^folders/ { printf "folders=("; for(i=2;i<=NF;i++) printf "%s ", $i; printf ");" }
    /^exclude/ { printf "exclude=("; for(i=2;i<=NF;i++) printf "%s ", $i; printf ");" }
    ' "$acct"`
    { test $? = 0 } || {
    error "Error parsing account: $acct"
    return 1 }

    eval "$ttmp"
    # check required fields

    # falling back to old host/port conf directives
    imap=${imap:-$host}
    host=${host:-$imap}

    smtp=${smtp:-$host}
    smtp=${smtp:-$imap}

    imap_port=${imap_port:-$port}
    smtp_port=${smtp_port:-$imap_port}

    # fill in defaults
	proto=${proto:-imap}
    name=${name:-$account}
	login=${login:-$email}
	email=${email:-$login}
	transport=${transport:-TLS1}
	imap_port=${imap_port:-993}
	smtp_port=${smtp_port:-587}
	auth=${auth:-plain}
	cert=${cert:-ignore}
	accountopt=${accountopt:-keep}

	act "account in use: $login"
    func "name: $name"
    func "email: $email"
    func "login: $login"

    func "host: $host"
    func "port: $port"

    func "imap: $imap"
    func "imap port: $imap_port"
    func "smtp: $smtp"
    func "smtp port: $smtp_port"

    func "trans: $transport"
    func "certfile: $certfile"
    func "cert: $cert"
    func "auth: $auth"
    [[ "$password" = "" ]] || func "password: manually set"
    func "options: $accountopt"
    func "folders: $folders"
    func "exclude: $exclude"
	my_hdr=`cat "$acct" | grep '^my_hdr'`
	[[ "$my_hdr" = "" ]] ||
		func "my_hdr:\n$my_hdr"

    return 0
}
