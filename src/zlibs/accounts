new_account() {
	fn new_account $*
	acct=$1
	req=(acct)
	ckreq || return 1

	[[ -r $ACCOUNTS/$acct ]] && {
		error "account already existing: $ACCOUNTS/$acct"
		return 1 }

	isemail $acct || {
		error "new account is not an email: $acct"
		return 1 }


	name=${acct%%@*}
	domain=${acct##*@}
	local options
	case $domain in
		gmail.com)
			imap=imap.gmail.com
			smtp=smtp.gmail.com
			auth=plain
			cert=check
			options=keep
			;;
		*)
			imap=mail.${domain}
			smtp=mail.${domain}
			auth=plain
			cert=check
			options=keep
			;;
	esac
	cat <<EOF > $ACCOUNTS/$acct
# automatically generated by 'jaro wizard' for account: $acct
# modifications will not be overwritten
name $name
email $acct
login $acct
proto imap
host $imap
smtp $smtp
auth $auth
cert $cert
options $options
EOF
	act "account succesfully generated for $acct"
	return 1
}

_wizard_prompt() {
    # Prompt on tty/stderr and read a single line from stdin for scripted tests.
    local _prompt="$1" _answer
    print -n -- "${_prompt}" >&2
    IFS= read -r _answer || return 1
    print -r -- "${_answer}"
}

_wizard_yesno() {
    # Accept y/yes or n/no, fallback to default on empty input.
    _prompt="$1"
    _default="$2"
    while true; do
        _answer="$(_wizard_prompt "${_prompt}")" || return 1
        _answer="${_answer:l}"
        case "${_answer}" in
            y|yes) return 0 ;;
            n|no) return 1 ;;
            "")
                [[ "${_default}" = "y" ]] && return 0
                return 1
                ;;
            *)
                warning "Please answer y or n."
                ;;
        esac
    done
}

_wizard_ensure_pass_ready() {
    [[ "$PASS" = "1" ]] || return 0
    [[ -f "$PASSWORD_STORE_DIR/.gpg-id" ]] && return 0

    act "pass keyring detected but not initialized: $PASSWORD_STORE_DIR"

    _gpg_id=""
    if [[ -r "$HOME/.gnupg/gpg.conf" ]]; then
        _gpg_id="$(awk '/^default-key/ { print $2; exit }' "$HOME/.gnupg/gpg.conf")"
    fi
    [[ -n "${_gpg_id}" ]] || _gpg_id="$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^sec:/ { print $5; exit }')"

    if [[ -z "${_gpg_id}" ]]; then
        if [[ ! -t 0 ]]; then
            warning "No default GPG secret key found; skipping pass initialization in non-interactive mode."
            return 0
        fi
        notice "No default GPG secret key found. Creating one now."
        gpg --full-generate-key || {
            error "GPG key generation failed."
            return 1
        }
        _gpg_id="$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^sec:/ { print $5; exit }')"
        [[ -n "${_gpg_id}" ]] || {
            error "No secret key available after generation."
            return 1
        }
    fi

    act "Initializing pass store with GPG key: ${_gpg_id}"
    pass init "${_gpg_id}" || {
        error "pass init failed."
        return 1
    }
    return 0
}

_wizard_check_port() {
    _host="$1"
    _port="$2"
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 3 "${_host}" "${_port}" >/dev/null 2>&1
        return $?
    fi
    warning "Cannot validate ${_host}:${_port} reachability (missing nc)."
    return 2
}

_account_quote_value() {
    local value="$1"
    # Account directives occupy one line. Reject controls that would create
    # another directive or a malformed header rather than changing their value.
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 1
    if [[ "$value" =~ '^[[:alnum:]_.:@%+/-]+$' ]]; then
        REPLY="$value"
    else
        value="${value//\\/\\\\}"
        value="${value//\"/\\\"}"
        REPLY="\"$value\""
    fi
}

_account_write_field() {
    local line="$1" value REPLY
    shift
    for value in "$@"; do
        _account_quote_value "$value" || {
            error "Cannot serialize $line: carriage returns and newlines are not supported"
            return 1
        }
        line+=" $REPLY"
    done
    print -r -- "$line"
}

_wizard_write_account() {
    local REPLY
    print -r -- "# automatically generated by 'jaro wizard' for account: $acct" || return 1
    print -r -- '# modifications will not be overwritten' || return 1
    _account_write_field name "$name" || return 1
    _account_write_field email "$acct" || return 1
    _account_write_field login "$login" || return 1
    _account_write_field proto imap || return 1
    _account_write_field imap "$imap" || return 1
    _account_write_field imap_port "$imap_port" || return 1
    _account_write_field smtp "$smtp" || return 1
    _account_write_field smtp_port "$smtp_port" || return 1
    _account_write_field auth plain || return 1
    _account_write_field cert check || return 1
    _account_write_field transport TLS1 || return 1
    _account_write_field options keep || return 1
    _account_write_field exclude "${exclude[@]}" || return 1
    _account_quote_value "$name" || return 1
    # my_hdr is passed verbatim to Mutt, whose config reader also expands
    # variables and backticks. Keep wizard display names literal there too.
    REPLY="${REPLY//\$/\\\$}"
    REPLY="${REPLY//\`/\\\`}"
    print -r -- "my_hdr From: $REPLY <$acct>"
}

account_wizard() {
    local staged_account='' publish_status=1
    local -A account_lines
    fn account_wizard
    _account_reset
    act "Account setup wizard"
    act "Collecting account identity"

    while true; do
        acct="$(_wizard_prompt "Email address: ")" || return 1
        [[ "$acct" =~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$' ]] && break
        warning "Please insert a valid email address."
    done

    [[ -e "$ACCOUNTS/$acct" || -L "$ACCOUNTS/$acct" ||
       -e "$ACCOUNTS/$acct.txt" || -L "$ACCOUNTS/$acct.txt" ]] && {
        error "account already existing: $ACCOUNTS/$acct"
        return 1
    }

    localpart="${acct%%@*}"
    domain="${acct##*@}"
    name_default="${localpart}"
    imap_default="mail.${domain}"
    smtp_default="mail.${domain}"

    name="$(_wizard_prompt "Display name [${name_default}]: ")" || return 1
    name="${name:-$name_default}"
    login="$(_wizard_prompt "Login [${acct}]: ")" || return 1
    login="${login:-$acct}"
    imap="$(_wizard_prompt "IMAP host [${imap_default}]: ")" || return 1
    imap="${imap:-$imap_default}"
    imap_port="$(_wizard_prompt "IMAP port [993]: ")" || return 1
    imap_port="${imap_port:-993}"
    smtp="$(_wizard_prompt "SMTP host [${smtp_default}]: ")" || return 1
    smtp="${smtp:-$smtp_default}"
    smtp_port="$(_wizard_prompt "SMTP port [587]: ")" || return 1
    smtp_port="${smtp_port:-587}"

    proto=imap host="$imap"
    _account_validate 'wizard input' || return 1
    exclude=(zz.spam zz.bounces zz.blacklist zz.social)

    if _wizard_yesno "Check IMAP reachability (${imap}:${imap_port}) now? [y/N] " "n"; then
        act "Checking IMAP reachability..."
        _wizard_check_port "$imap" "$imap_port"
        case $? in
            0) notice "IMAP host reachable." ;;
            1) warning "IMAP host not reachable." ;;
            *) ;;
        esac
    fi

    if _wizard_yesno "Check SMTP reachability (${smtp}:${smtp_port}) now? [y/N] " "n"; then
        act "Checking SMTP reachability..."
        _wizard_check_port "$smtp" "$smtp_port"
        case $? in
            0) notice "SMTP host reachable." ;;
            1) warning "SMTP host not reachable." ;;
            *) ;;
        esac
    fi

    print >&2
    act "Account summary"
    print -r -- "name=${name}" >&2
    print -r -- "email=${acct}" >&2
    print -r -- "login=${login}" >&2
    print -r -- "imap=${imap}:${imap_port}" >&2
    print -r -- "smtp=${smtp}:${smtp_port}" >&2

    _wizard_yesno "Write account file now? [Y/n] " "y" || {
        warning "Wizard aborted, nothing written."
        return 1
    }

    [[ -d "$ACCOUNTS" ]] || command mkdir -p -- "$ACCOUNTS" || return 1
    staged_account="$(mktemp "$ACCOUNTS/.wizard.XXXXXXXX")" || {
        error "Cannot create private account staging file in $ACCOUNTS"
        return 1
    }
    {
        if _wizard_write_account > "$staged_account" &&
           ( _account_load_file "$staged_account" ); then
            # POSIX link uses the exact destination pathname: it cannot replace
            # a file/symlink or silently publish inside an existing directory.
            if command link "$staged_account" "$ACCOUNTS/$acct"; then
                publish_status=0
            else
                error "Cannot publish account without overwriting: $ACCOUNTS/$acct"
            fi
        fi
    } always {
        command rm -f -- "$staged_account" || publish_status=1
    }
    (( publish_status == 0 )) || return 1

    account="$acct"
    host="$imap"
    email="$acct"
    _wizard_ensure_pass_ready || return 1

    act "Account configuration saved: $ACCOUNTS/$acct"
    notice "Use 'jaro -a $acct passwd' to store credentials."
    return 0
}

# Account files contain data, never shell expressions. Keep this lexer separate
# from shell word splitting: even (z) tokenization has shell-specific syntax.
_account_values() {
    local text="$1" list="$2" char quote='' word='' pending='' escaped=0 started=0 boundary=1 i
    reply=()
    for (( i=1; i <= ${#text}; i++ )); do
        char="${text[i]}"
        if [[ -z "$quote" && $escaped == 0 && "$char" == '#' && $boundary == 1 ]]; then
            break
        fi
        if [[ -z "$quote" && $escaped == 0 && "$char" == [[:space:]] && "$list" == 0 ]]; then
            pending+="$char"
            boundary=1
            continue
        fi
        if [[ "$list" == 0 ]]; then word+="$pending"; pending=''; fi
        if (( escaped )); then
            word+="$char"
            escaped=0
            started=1
        elif [[ "$quote" == "'" ]]; then
            if [[ "$char" == "'" ]]; then quote=''; else word+="$char"; fi
        elif [[ "$char" == '\' ]]; then
            escaped=1
            started=1
        elif [[ -n "$quote" ]]; then
            if [[ "$char" == '"' ]]; then quote=''; else word+="$char"; fi
        elif [[ "$char" == '"' || "$char" == "'" ]]; then
            quote="$char"
            started=1
        elif [[ "$char" == [[:space:]] && "$list" == 1 ]]; then
            if (( started )); then reply+=("$word"); word=''; started=0; fi
        else
            word+="$char"
            started=1
        fi
        if [[ -z "$quote" && $escaped == 0 && "$char" == [[:space:]] && $started == 0 ]]; then
            boundary=1
        else
            boundary=0
        fi
    done
    [[ -z "$quote" && $escaped == 0 ]] || return 1
    if [[ "$list" == 0 ]]; then
        reply=("$word")
    elif (( started )); then
        reply+=("$word")
    fi
    return 0
}

_account_reset() {
    typeset -g name='' email='' login='' proto='' protocol='' iproto='' \
        imap='' imap_port='' smtp='' smtp_port='' host='' port='' \
        transport='' auth='' cert='' certfile='' password='' \
        accountopt='' my_hdr=''
    typeset -ga folders=() exclude=() _account_smtp_identity=()
}

_account_valid_port() {
    setopt localoptions extendedglob
    [[ "$1" == <-> ]] || return 1
    local number="${1##0#}"
    [[ -n "$number" && ${#number} -le 5 ]] || return 1
    (( 10#$number >= 1 && 10#$number <= 65535 ))
}

_account_valid_host() {
    # DNS/IPv4 names and IPv6 literals; reject options, whitespace and syntax
    # that a downstream transport could interpret as something besides a host.
    local server="$1"
    [[ "$server" == \[*\] ]] && server="${server[2,-2]}"
    if [[ "$server" == *:* ]]; then
        [[ "$server" != *[^[:xdigit:]:.]* && "$server" != ':' ]]
    else
        [[ "$server" =~ '^[[:alnum:]_][[:alnum:]_.-]*$' ]]
    fi
}

_account_validate() {
    local source="$1" field value
    [[ "$proto" == imap || "$proto" == pop ]] || {
        error "$source:${account_lines[proto]:-1}: unsupported proto (use imap or pop)"
        return 1
    }
    for field value in imap "$imap" smtp "$smtp" host "$host"; do
        _account_valid_host "$value" || {
            error "$source:${account_lines[$field]:-${account_lines[host]:-1}}: invalid or missing $field host"
            return 1
        }
    done
    for field value in port "$port" imap_port "$imap_port" smtp_port "$smtp_port"; do
        [[ -n "$value" ]] || continue
        _account_valid_port "$value" || {
            error "$source:${account_lines[$field]:-1}: $field must be an integer from 1 to 65535"
            return 1
        }
    done
    return 0
}

_account_load_file() {
    setopt localoptions extendedglob
    local source="$1" line raw_line key value mode lineno=0
    local -a reply
    local -A account_lines
    _account_reset
    while IFS= read -r line || [[ -n "$line" ]]; do
        (( lineno += 1 ))
        raw_line="$line"
        line="${line##[[:space:]]#}"
        [[ -n "$line" && "$line" != \#* ]] || continue
        key="${line%%[[:space:]]*}"
        # Mutt owns this directive's syntax. Its header text may contain an
        # apostrophe or backslash that is not account-value quoting at all.
        if [[ "$key" == my_hdr ]]; then
            [[ -z "$my_hdr" ]] || my_hdr+=$'\n'
            my_hdr+="$raw_line"
            continue
        fi
        value="${line#$key}"
        value="${value##[[:space:]]#}"
        value="${value%%[[:space:]]#}"
        mode=0
        case "$key" in
            folders|exclude) mode=1 ;;
            name|email|login|proto|imap|smtp|host|port|imap_port|smtp_port|transport|certfile|auth|cert|password|options) ;;
            *) error "$source:$lineno: unknown account directive: $key"; _account_reset; return 1 ;;
        esac
        _account_values "$value" "$mode" || {
            error "$source:$lineno: malformed quoting in $key"
            _account_reset
            return 1
        }
        account_lines[$key]=$lineno
        value="${reply[1]-}"
        case "$key" in
            proto|imap|smtp|host|port|imap_port|smtp_port|transport|auth|cert|certfile|email|login)
                [[ -n "$value" ]] || {
                    error "$source:$lineno: missing value for $key"
                    _account_reset
                    return 1
                } ;;
        esac
        case "$key" in
            name) name="$value" ;; email) email="$value" ;; login) login="$value" ;;
            proto) proto="$value" ;; imap) imap="$value" ;; smtp) smtp="$value" ;;
            host) host="$value" ;; port) port="$value" ;;
            imap_port) imap_port="$value" ;; smtp_port) smtp_port="$value" ;;
            transport) transport="$value" ;; certfile) certfile="$value" ;;
            auth) auth="$value" ;; cert) cert="$value" ;; password) password="$value" ;;
            options) accountopt="$value" ;;
            folders) folders=("${reply[@]}") ;; exclude) exclude=("${reply[@]}") ;;
        esac
    done < "$source"

    # Historical host/port aliases and order of defaults are intentional.
    imap=${imap:-$host}
    host=${host:-$imap}
    smtp=${smtp:-${host:-$imap}}
    imap_port=${imap_port:-$port}
    smtp_port=${smtp_port:-$imap_port}
    proto=${proto:-imap}
    name=${name:-$account}
    login=${login:-$email}
    email=${email:-$login}
    transport=${transport:-TLS1}
    imap_port=${imap_port:-993}
    smtp_port=${smtp_port:-587}
    auth=${auth:-plain}
    cert=${cert:-ignore}
    accountopt=${accountopt:-keep}
    _account_validate "$source" || { _account_reset; return 1; }
    return 0
}

# -a defines which account name other than 'default'
# results in the definition of global account variables:
# name login host protocol port auth folders accountopt
read_account() {
    local cached_password=''
    local -a previous_identity=("${_account_smtp_identity[@]-}")
    # send explicitly retains a password for a batch. It may only be reused
    # for the same already-loaded SMTP identity, never another account/host.
    if [[ "${smtp_keep_password:-0}" == 1 && "${type:-}" == smtp &&
          "${host:-}" == "${smtp:-}" && "${port:-}" == "${smtp_port:-}" ]]; then
        cached_password="${password:-}"
    fi
    _account_reset
    # parse arguments

    [[ "${account:-}" = "" ]] && account="default"

    # find the account
    func "read_account looking for $account"
    acct="$ACCOUNTS/$account";
    { test -r "$acct" } || {
        acct="$ACCOUNTS/${account}.txt"
        { test -r "$acct" } || {
            error "no account found: $acct"
            act "Refine your argument using '-a accountname'"
            act "Available accounts:"
            ls "$ACCOUNTS/"
            return 1
        }
    }

    _account_load_file "$acct" || return 1
    _account_smtp_identity=("$acct" "$login" "$email" "$smtp" "$smtp_port" "$auth" "$transport" "$certfile")
    if [[ -z "$password" && "${(qqq)previous_identity}" == "${(qqq)_account_smtp_identity}" ]]; then
        password="$cached_password"
    fi

	act "account in use: $login"
    func "name: $name"
    func "email: $email"
    func "login: $login"

    func "host: $host"
    func "port: $port"

    func "imap: $imap"
    func "imap port: $imap_port"
    func "smtp: $smtp"
    func "smtp port: $smtp_port"

    func "trans: $transport"
    func "certfile: $certfile"
    func "cert: $cert"
    func "auth: $auth"
    [[ "$password" = "" ]] || func "password: manually set"
    func "options: $accountopt"
    func "folders: $folders"
    func "exclude: $exclude"
	[[ "$my_hdr" = "" ]] ||
		func "my_hdr:\n$my_hdr"

    return 0
}
