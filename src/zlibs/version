#!/usr/bin/env zsh
# Installed releases read their assigned version; source checkouts resolve tags.
jaromail_version() {
    local script_dir="$1" stamp source_root
    REPLY=''
    if [[ -n ${JAROWORKDIR:-} && -r "$JAROWORKDIR/VERSION" ]]; then
        stamp="$JAROWORKDIR/VERSION"
    elif [[ -r "$script_dir/../VERSION" ]]; then
        stamp="$script_dir/../VERSION"
    elif [[ -r "$script_dir/VERSION" ]]; then
        stamp="$script_dir/VERSION"
    else
        print -u2 -- 'Cannot find JaroMail version metadata'
        return 1
    fi
    source_root="${stamp:A:h}"
    if [[ -r "$source_root/build/version.py" ]] && command -v python3 >/dev/null 2>&1; then
        REPLY="$(python3 "$source_root/build/version.py" --source "$source_root")" || return $?
    else
        REPLY="$(< "$stamp")"
    fi
    [[ $REPLY =~ '^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]+)?$' ]] || {
        print -u2 -- 'Invalid JaroMail version metadata'
        return 1
    }
}
