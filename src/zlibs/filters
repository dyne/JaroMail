# Historical selector names both select the installed Pigeonhole engine.
filter_engine() {
    REPLY=${JARO_FILTER_ENGINE-native}
    case "$REPLY" in
        legacy|native|sieve) REPLY=sieve; return 0 ;;
        *) error "Invalid JARO_FILTER_ENGINE: ${(qqq)REPLY}; expected sieve, native or legacy"; return 2 ;;
    esac
}

# Fresh roots can compile on first apply. Existing generations migrate only
# through explicit publication, before fetch opens a transport or mailbox.
sieve_generation_ready() {
    local selected="$MAILDIRS/cache/filter-engine/current"
    if [[ -L $selected || -e $selected ]]; then
        [[ -f "$selected/dependencies" && -s "$selected/Filters.svbin" ]] || {
            print -ru2 -- 'This filter generation needs migration; run jaro update explicitly'
            return 5
        }
    fi
}

filter_policy_template() {
    filter_engine || return $?
    REPLY=''
    if [[ -e "$MAILDIRS/Filters.txt" || -L "$MAILDIRS/Filters.txt" ]]; then
        [[ -f "$MAILDIRS/Filters.txt" && -r "$MAILDIRS/Filters.txt" ]] || {
            error "Unreadable policy: $MAILDIRS/Filters.txt"; return 3
        }
        return 0
    fi
    REPLY="$WORKDIR/Filters.native.txt"
    [[ -f $REPLY && -r $REPLY ]] || {
        error "Missing filter template: $REPLY"; return 3
    }
}

native_filter_compile() {
    setopt localoptions extendedglob
    local report result
    local -a fields args
    args=(--root "$MAILDIRS" --accounts-dir "$ACCOUNTS" --report0)
    [[ $DRYRUN == 1 || ${native_filter_readonly:-0} == 1 ]] && args+=(--check)
    # A sentinel prevents command substitution from stripping trailing LF from
    # this binary protocol. Preserve the compiler's status independently.
    report=$(
        local capture_result=0
        "$WORKDIR/bin/jaro-filter-compile" "${args[@]}" || capture_result=$?
        print -rn -- $'\1'
        exit $capture_result
    )
    result=$?
    report=${report%$'\1'}
    (( result == 0 )) || return $result
    fields=("${(@0)report}")
    if [[ ${#fields} != 5 || "$fields[1]" != JFC1 || "$fields[2]" != [0-9a-f](#c64) ||
          "$fields[3]" != [01] || -n "$fields[5]" ]]; then
        error "Malformed native compiler report"; return 5
    fi
    typeset -g filter_native_ready=1 filter_native_directory="$fields[4]" filter_native_generation="$fields[2]"
    return 0
}

update_filters() {
    native_filter_compile
}

update_sieve() {
    [[ ${filter_native_ready:-0} == 1 ]] || native_filter_compile
}

init_inbox() {
    fn init_inbox
    req=(MAILDIRS)
    ckreq || return 1
    filter_policy_template || return $?
    local init_filter_template=$REPLY

    # make sure maildirs where to put mails exist
    ${=mkdir} "$MAILDIRS"
    maildirmake "$MAILDIRS"/{incoming,known,sent,priv,postponed,drafts,unsorted,remember,outbox} || return $?

    [[ -f "$PASSWORD_STORE_DIR/.gpg-id" ]] || {
		[[ -r $HOME/.gnupg/gpg.conf ]] && {
            GPGID=${$(awk '/default-key/ { print $2 }' $HOME/.gnupg/gpg.conf)}
			pass init ${GPGID}
		}
    }

    ${=mkdir} "$MAILDIRS/cache"
    ${=mkdir} "$MAILDIRS/logs"
    ${=mkdir} "$MAILDIRS/tmp"
    ${=mkdir} "$ACCOUNTS"

    test -r "$ACCOUNTS/default.txt" ||
		cp -a "$WORKDIR"/Accounts/* "$ACCOUNTS/"

    { test -r "$MAILDIRS"/Manual.pdf } || {
    cp "$WORKDIR"/jaromail-manual.pdf "$MAILDIRS"/Manual.pdf }

    [[ -z $init_filter_template ]] ||
        cp -n -- "$init_filter_template" "$MAILDIRS/Filters.txt" || return 3

    { test -r "$MAILDIRS"/Aliases.txt } || {
    cp "$WORKDIR"/Aliases.txt "$MAILDIRS"/Aliases.txt }

    { test -r "$MAILDIRS"/Applications.txt } || {
    cp "$WORKDIR"/Applications.txt "$MAILDIRS"/Applications.txt }

    # make sure the permissions are private
    chmod 700 "$MAILDIRS"

    return 0
}

filter_maildir() {
    native_filter_maildir "$@"
}

cmd_filter() {
    local native_filter_explain=0 native_filter_compare=''
    option.is_set -e && native_filter_explain=1
    if option.is_set -c; then
        native_filter_compare=${option[-c]}
        [[ -n $native_filter_compare ]] || { print -ru2 -- 'The --compare option requires an observation file'; return 2; }
    fi
    filter_engine || return $?
    (( ${#option_params} <= 1 )) || { error "filter accepts one Maildir"; return 2; }
    filter_maildir "${option_params[@]}"
    exitcode=$?
}
