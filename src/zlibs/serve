#!/usr/bin/env zsh
#
# jaro serve: localhost-only IMAP bridge over local maildirs
# REPR:
# - Request: environment-driven runtime options
# - Endpoint: cmd_serve orchestration
# - Response: stable terminal output with connection details

# Validate and normalize request values for `jaro serve`.
serve_request() {
    fn serve_request

    serve_host="${JARO_SERVE_HOST:-127.0.0.1}"
    case "$serve_host" in
        localhost|127.0.0.1) serve_host="127.0.0.1" ;;
        *)
            error "Invalid JARO_SERVE_HOST '$serve_host' (localhost only)"
            return 1
            ;;
    esac

    serve_port="${JARO_SERVE_PORT:-61443}"
    [[ "$serve_port" =~ '^[0-9]+$' ]] || {
        error "Invalid JARO_SERVE_PORT '$serve_port' (must be numeric)"
        return 1
    }
    (( serve_port >= 1024 && serve_port <= 65535 )) || {
        error "Invalid JARO_SERVE_PORT '$serve_port' (range 1024-65535)"
        return 1
    }

    serve_user="${JARO_SERVE_USER:-jaro}"
    [[ -n "$serve_user" ]] || {
        error "Invalid JARO_SERVE_USER (empty)"
        return 1
    }

    serve_max_connections="${JARO_SERVE_MAX_CONNECTIONS:-4}"
    [[ "$serve_max_connections" =~ '^[0-9]+$' ]] || {
        error "Invalid JARO_SERVE_MAX_CONNECTIONS '$serve_max_connections' (must be numeric)"
        return 1
    }
    (( serve_max_connections >= 1 && serve_max_connections <= 16 )) || {
        error "Invalid JARO_SERVE_MAX_CONNECTIONS '$serve_max_connections' (range 1-16)"
        return 1
    }

    if [[ -n "${JARO_SERVE_CONFIG_ONLY:-}" && "${JARO_SERVE_CONFIG_ONLY}" != "0" ]]; then
        serve_config_only=1
    else
        serve_config_only=0
    fi

    serve_mail_root="${MAILDIRS:A}"
    case "$serve_mail_root" in
        *:*|*%*|*$'\n'*|*$'\r'*)
            error "MAILDIRS must not contain colons, percent signs or newlines"
            return 1
            ;;
    esac
    serve_runtime="${MAILDIRS}/.imap"
    [[ ! -L "$serve_runtime" ]] || {
        error "Refusing a symlinked IMAP runtime"
        return 1
    }
    serve_runtime="${serve_runtime:A}"
    serve_conf="${serve_runtime}/dovecot.conf"
    serve_passwd_file="${serve_runtime}/passwd"
    serve_log_dir="${serve_runtime}/log"
    serve_log_file="${serve_log_dir}/dovecot.log"
    serve_info_log_file="${serve_log_dir}/dovecot-info.log"
    serve_uid="$(id -u)"
    serve_gid="$(id -g)"
    serve_system_user="$(id -un)" || return 1
    serve_system_group="$(id -gn)" || return 1
    (( serve_uid != 0 )) || {
        error "Run jaro serve as the owner of the mail, not root"
        return 1
    }

    serve_validate_passwd_field JARO_SERVE_USER "$serve_user" || return 1
    [[ "$serve_user" != \#* && "$serve_user" != *[[:space:]]* ]] || {
        error "JARO_SERVE_USER must not start with # or contain whitespace"
        return 1
    }

    return 0
}

# Dovecot passwd-file fields must not contain separators/newlines.
serve_validate_passwd_field() {
    fn serve_validate_passwd_field
    local _field_name="$1"
    local _field_value="$2"

    [[ "$_field_value" == *:* ]] && {
        error "Invalid ${_field_name}: ':' is not allowed"
        return 1
    }
    [[ "$_field_value" == *$'\n'* || "$_field_value" == *$'\r'* ]] && {
        error "Invalid ${_field_name}: newlines are not allowed"
        return 1
    }
    return 0
}

# Escape the contents of a quoted dovecot.conf string. Percent expansion in
# mail paths is rejected above rather than interpreting a directory as a template.
serve_escape_dovecot_path() {
    local _path="$1"
    _path="${_path//\\/\\\\}"
    _path="${_path//\"/\\\"}"
    print -r -- "$_path"
}

# Config-only works without Dovecot; a live launch requires matching 2.4 tools.
serve_check_version() {
    local version
    if command -v dovecot >/dev/null 2>&1; then
        version="$(dovecot --version)" || return 1
        [[ "$version" == 2.4.<->* ]] || {
            error "jaro serve requires Dovecot 2.4.x (found $version)"
            return 1
        }
    elif [[ "$serve_config_only" != 1 ]]; then
        error "jaro serve requires Dovecot 2.4.x"
        return 1
    fi
    if [[ "$serve_config_only" != 1 ]] && ! command -v doveconf >/dev/null 2>&1; then
        error "jaro serve requires doveconf from the same Dovecot installation"
        return 1
    fi
}

# Keep canonical maildirs present so IMAP exposure is predictable.
serve_ensure_maildirs() {
    fn serve_ensure_maildirs

    ${=mkdir} "$MAILDIRS" || return 1
    for md in incoming known sent priv postponed drafts unsorted remember outbox; do
        maildirmake "$MAILDIRS/$md" || return 1
    done
    ${=mkdir} "$MAILDIRS/cache" || return 1
    ${=mkdir} "$MAILDIRS/logs" || return 1

    return 0
}

# Prepare generated runtime directories with private permissions.
serve_prepare_runtime() {
    fn serve_prepare_runtime

    ${=mkdir} "$serve_runtime" || return 1
    ${=mkdir} "$serve_runtime/index" || return 1
    ${=mkdir} "$serve_runtime/control" || return 1
    ${=mkdir} "$serve_runtime/run" || return 1
    ${=mkdir} "$serve_runtime/state" || return 1
    ${=mkdir} "$serve_log_dir" || return 1

    return 0
}

# Build one launch password, optionally overridden from env.
serve_generate_password() {
    fn serve_generate_password

    if [[ -n "${JARO_SERVE_PASSWORD:-}" ]]; then
        serve_password="$JARO_SERVE_PASSWORD"
        return 0
    fi

    if command -v openssl >/dev/null 2>&1; then
        serve_password="$(openssl rand -base64 24 | tr -d '\n')"
    elif [[ -r /dev/urandom ]] && command -v od >/dev/null 2>&1; then
        serve_password="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
    else
        error "Cannot generate password (need openssl or od with /dev/urandom)"
        return 1
    fi

    [[ -n "$serve_password" ]] || {
        error "Cannot generate password (empty result)"
        return 1
    }

    return 0
}

# Render dovecot.conf from request/domain state.
serve_render_dovecot_conf() {
    local _mail_root _runtime _passwd_file _log_file _info_log_file
    _mail_root="$(serve_escape_dovecot_path "$serve_mail_root")"
    _runtime="$(serve_escape_dovecot_path "$serve_runtime")"
    _passwd_file="$(serve_escape_dovecot_path "$serve_passwd_file")"
    _log_file="$(serve_escape_dovecot_path "$serve_log_file")"
    _info_log_file="$(serve_escape_dovecot_path "$serve_info_log_file")"

    cat <<EOF
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0
protocols {
  imap = yes
}
listen = ${serve_host}
ssl = no
auth_allow_cleartext = yes
auth_mechanisms = plain
auth_username_format = %{user}
default_internal_user = ${serve_system_user}
default_login_user = ${serve_system_user}
default_internal_group = ${serve_system_group}
first_valid_uid = ${serve_uid}
last_valid_uid = ${serve_uid}
first_valid_gid = ${serve_gid}
last_valid_gid = ${serve_gid}

mail_driver = maildir
mail_path = "${_mail_root}"
mailbox_list_layout = fs
mail_index_path = "${_runtime}/index"
mail_control_path = "${_runtime}/control"
mail_home = "${_mail_root}"
mail_uid = ${serve_uid}
mail_gid = ${serve_gid}

base_dir = "${_runtime}/run"
state_dir = "${_runtime}/state"
log_path = "${_log_file}"
info_log_path = "${_info_log_file}"

passdb passwd-file {
  passwd_file_path = "${_passwd_file}"
}

userdb static {
}

service anvil {
  chroot =
}
service auth-worker {
  user = ${serve_system_user}
}

service imap-login {
  chroot =
  process_limit = ${serve_max_connections}
  restart_request_count = 1
  inet_listener imap {
    port = ${serve_port}
  }
  inet_listener imaps {
    port = 0
  }
}

service imap {
  process_limit = ${serve_max_connections}
}
EOF
}

# Write generated runtime files.
serve_write_runtime_files() {
    fn serve_write_runtime_files

    serve_validate_passwd_field "JARO_SERVE_USER" "$serve_user" || return 1
    serve_validate_passwd_field "JARO_SERVE_PASSWORD" "$serve_password" || return 1

    print -r -- "${serve_user}:{PLAIN}${serve_password}" > "$serve_passwd_file" || return 1
    chmod 600 "$serve_passwd_file" || return 1

    serve_render_dovecot_conf > "$serve_conf" || return 1
    chmod 600 "$serve_conf" || return 1

    return 0
}

# Validate generated config if doveconf exists.
serve_validate_config() {
    fn serve_validate_config
    command -v doveconf >/dev/null 2>&1 || return 0
    _doveconf_out="$(doveconf -c "$serve_conf" -n 2>&1)" || {
        error "doveconf rejected generated config: $_doveconf_out"
        return 1
    }
    return 0
}

# Return 0 when a listener conflicts with requested bind.
serve_port_listener_conflicts() {
    fn serve_port_listener_conflicts
    local _listener="$1"

    case "$_listener" in
        "127.0.0.1:${serve_port}"|"localhost:${serve_port}"|"0.0.0.0:${serve_port}"|"*:${serve_port}"|"[::]:${serve_port}"|":::${serve_port}")
            return 0
            ;;
    esac
    return 1
}

# Return 0 when selected port is already listening on conflicting address, 1 when free, 2 when unknown.
serve_port_in_use() {
    fn serve_port_in_use
    local _listener

    if command -v lsof >/dev/null 2>&1; then
        while IFS= read -r _listener; do
            serve_port_listener_conflicts "$_listener" && return 0
        done < <(lsof -nP -iTCP:${serve_port} -sTCP:LISTEN 2>/dev/null | awk '{print $9}')
        return 1
    fi

    if command -v ss >/dev/null 2>&1; then
        while IFS= read -r _listener; do
            serve_port_listener_conflicts "$_listener" && return 0
        done < <(ss -ltn 2>/dev/null | awk '{print $4}')
        return 1
    fi

    if command -v netstat >/dev/null 2>&1; then
        while IFS= read -r _listener; do
            serve_port_listener_conflicts "$_listener" && return 0
        done < <(netstat -ltn 2>/dev/null | awk '{print $4}')
        return 1
    fi

    return 2
}

# Response payload for users and tests.
serve_response() {
    print -r -- "Host: ${serve_host}"
    print -r -- "Port: ${serve_port}"
    print -r -- "TLS: none"
    print -r -- "User: ${serve_user}"
    print -r -- "Password: ${serve_password}"
    print -r -- "Credentials: ${serve_passwd_file}"
    print -r -- "Config: ${serve_conf}"
    print -r -- "Log: ${serve_log_file}"
    print -r -- "Mail root: ${serve_mail_root}"
}

# Keep the shell's advisory lock alive until Dovecot exits. Dovecot closes
# inherited descriptors, so exec would release it prematurely. Signals target
# only our child and wait for shutdown before releasing runtime ownership.
serve_exec_dovecot() {
    fn serve_exec_dovecot
    local serve_pid
    dovecot -F -c "$serve_conf" &
    serve_pid=$!
    trap 'kill -TERM "$serve_pid" 2>/dev/null; wait "$serve_pid" 2>/dev/null; exit 130' INT
    trap 'kill -TERM "$serve_pid" 2>/dev/null; wait "$serve_pid" 2>/dev/null; exit 143' TERM
    trap 'kill -TERM "$serve_pid" 2>/dev/null; wait "$serve_pid" 2>/dev/null; exit 129' HUP
    wait "$serve_pid"
}

# Never unlink the lock file: contenders share its inode. Keep the CLI process
# supervising Dovecot so signals sent to jaro also stop its child.
cmd_serve() {
    setopt localoptions localtraps
    umask 077
    fn cmd_serve

    serve_request || return 1
    if [[ "${DRYRUN:-0}" == 1 ]]; then
        print -r -- "Would serve $serve_mail_root on $serve_host:$serve_port using Dovecot 2.4.x"
        return 0
    fi
    serve_check_version || return 1

    local serve_lock_fd live_pid
    [[ ! -L "$serve_runtime" ]] || return 1
    command mkdir -p -m 700 -- "$serve_runtime" || return 1
    [[ ! -L "$serve_runtime/lock" ]] || return 1
    ( : >> "$serve_runtime/lock" ) || return 1
    zmodload zsh/system || return 1
    zsystem flock -t 0 -f serve_lock_fd "$serve_runtime/lock" || {
        error "A jaro serve instance already owns $serve_runtime"
        return 1
    }
    {
    # Also protect a daemon orphaned by SIGKILL of its supervising shell.
    if [[ -r "$serve_runtime/run/master.pid" ]]; then
        read -r live_pid < "$serve_runtime/run/master.pid"
        if [[ "$live_pid" == <-> ]] && kill -0 "$live_pid" 2>/dev/null; then
            error "Dovecot is already running in $serve_runtime"
            return 1
        fi
    fi

    local port_status=0
    serve_port_in_use || port_status=$?
    case $port_status in
        0)
            error "Port busy: ${serve_host}:${serve_port}"
            return 1
            ;;
        2)
            warning "No port preflight tool found, relying on dovecot bind checks"
            ;;
    esac

    serve_ensure_maildirs || return 1
    serve_prepare_runtime || return 1
    serve_generate_password || return 1
    serve_write_runtime_files || return 1
    serve_validate_config || return 1
    serve_response
    [[ "$serve_config_only" == 1 ]] && return 0
    serve_exec_dovecot
    } always {
        zsystem flock -u "$serve_lock_fd"
    }
}
