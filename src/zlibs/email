# read an email from stdin and send it via msmtp
smtp_send() {
    fn smtp-send
    local msmtpcfg smtp_status=1 trust_file
    smtp_delivery_outcome=not-started
    req=(account)
    ckreq || return 1

    read_account ${account}
    [[ $? = 0 ]] || {
        error "Invalid account: $account"
        return 1
    }

    # defaults
    [[ -z $auth ]] && { auth=plain }
    [[ -z $smtp_port ]] && { smtp_port=25 }

    notice "SMTP send via account ${account}"

    type=smtp
    host=$smtp
    port=$smtp_port

    # Let msmtp verify the certificate and hostname on the sending connection.
    # A separate probe cannot authenticate the connection carrying credentials.
    trust_file="${certfile:-system}"
    [[ "$trust_file" == system || -r "$trust_file" ]] || {
        error "Cannot read SMTP CA file: $trust_file"
        return 1
    }

    [[ "$password" = "" ]] && {
        ask_password
        [[ $? = 0 ]] || {
            error "Error retrieving smtp password for $login on $host"
            unset password
            return 1 }
    }

    ztmp || return 1
    msmtpcfg=$ztmpfile
    [[ -n "$msmtpcfg" && -f "$msmtpcfg" ]] || return 1
    {
    if cat <<EOF > "$msmtpcfg"
account default
from ${email}
user ${login}
host ${smtp}
port ${smtp_port}
tls on
tls_starttls on
tls_certcheck on
tls_trust_file "${trust_file}"
auth ${auth}
password ${password}
EOF
    then
        [[ "${smtp_keep_password:-0}" = 1 ]] || unset password
        smtp_delivery_outcome=uncertain
        msmtp -C "$msmtpcfg" -t
        smtp_status=$?
        (( smtp_status == 0 )) && smtp_delivery_outcome=accepted
    fi
    } always {
        [[ "${smtp_keep_password:-0}" = 1 ]] || unset password
        command rm -f -- "$msmtpcfg" || smtp_status=1
    }
    func "msmtp returns: $smtp_status"
    return $smtp_status
}

outbox_state() {
    local helper="$WORKDIR/bin/jaro-outbox"
    # The source bootstrap also supports WORKDIR=src.
    [[ -x "$helper" ]] || helper="$WORKDIR/../build/gnu/jaro-outbox"
    [[ -x "$helper" ]] || { error "Missing recovery helper: jaro-outbox"; return 1; }
    "$helper" "$1" "$MAILDIRS" "$2"
}

outbox_send_one() {
    local qbody="$1" relative="${1:h:t}/${1:t}" report id state res
    local -a fields
    outbox_item_held=0
    if ! report=$(outbox_state prepare "$relative"); then
        error "Outbox item held: recovery state or message validation failed"
        outbox_item_held=1
        return 1
    fi
    fields=( ${=report} )
    (( ${#fields} == 2 )) || { outbox_item_held=1; return 1; }
    id="$fields[1]" state="$fields[2]"
    case "$state" in
        accepted|verified|complete)
            notice "Finishing local sent copy for outbox $id (no SMTP)"
            outbox_state finish "$relative"
            return $?
            ;;
        inflight|uncertain)
            warning "Outbox $id held: delivery uncertain; explicit reconciliation required"
            outbox_item_held=1
            return 1
            ;;
        prepared) ;;
        *) outbox_item_held=1; return 1 ;;
    esac
    # A checked durable transition is required before even invoking smtp_send.
    outbox_state inflight "$relative" || { outbox_item_held=1; return 1; }
    act "Sending out email via ${account:-default} account (outbox $id)"
    smtp_keep_password=1
    smtp_delivery_outcome=uncertain
    # Transport reads the private snapshot, never changing live queue bytes.
    smtp_send < "$MAILDIRS/.outbox-state/$id/message"
    res=$?
    if [[ "$smtp_delivery_outcome" == accepted || $res == 0 ]]; then
        # Also preserve acceptance if removing the private SMTP config failed.
        outbox_state accepted "$relative" || { outbox_item_held=1; return 1; }
        (( interrupted == 0 )) || return $interrupted
        hdr "$MAILDIRS/.outbox-state/$id/message" | learn recipient
        outbox_state finish "$relative" || return 1
        return $res
    fi
    if [[ "$smtp_delivery_outcome" == not-started ]]; then
        outbox_state not-started "$relative" || return 1
    else
        outbox_state uncertain "$relative" || { outbox_item_held=1; return 1; }
        warning "Outbox $id held: SMTP outcome uncertain (status $res)"
        outbox_item_held=1
    fi
    return $res
}


