# PEEK
# this function will open the MTA to the imap server without fetching mails locally
peek() {
    fn peek $*

    read_account ${account}
    [[ $? = 0 ]] || {
        error "Invalid account: $account"
        return 1
    }

    is_online ${imap} ${imap_port}
    { test $? = 0 } || { return 1 }

    notice "Peek into remote imap account $name"

    folder=""
    if ! [ -z ${1} ]; then
		folder="${1}"
		act "opening folder ${folder}"
    fi
	iproto="imaps"
	[[ "$transport" == "plain" ]] && {
		warning "using clear text connection"
		iproto="imap"
    }
	act "IMAP transport: $transport ($iproto)"

    # escape at sign in login
    ilogin=`print $login | sed 's/@/\\@/'`

    { test $DRYRUN != 1 } && {

		type=imap
		host=$imap
		port=$imap_port

		x_mutt -f ${iproto}://${ilogin}@${imap}:${imap_port}/${folder}

    } # DRYRUN
    return $?
}

cmd_compose() {
    stdin_compose ${option_params}
    exitcode=$?
}

cmd_queue() {
    stdin_queue ${option_params}
    exitcode=$?
}

cmd_fetch() {
    filter_engine || { exitcode=$?; return $exitcode; }
    if [[ $REPLY == native ]]; then
        # A dry fetch explains the current incoming batch without transport,
        # account/keyring setup, cache publication or index writes.
        if [[ $DRYRUN == 1 ]]; then
            native_filter_maildir "$MAILDIRS/incoming"
            exitcode=$?
            return $exitcode
        fi
        fetch "${option_params[@]}" || { exitcode=$?; return $exitcode; }
        native_filter_compile batch || { exitcode=$?; return $exitcode; }
        local native_filter_workflow_generation=$filter_native_generation result index_result
        native_filter_maildir "$MAILDIRS/incoming"
        result=$?
        # A partial batch can have delivered intact messages. Index once even
        # on error; retain the batch failure if indexing also fails.
        update_notmuch
        index_result=$?
        (( result == 0 )) && result=$index_result
        exitcode=$result
        return $result
    fi
    fetch "${option_params[@]}" && \
        update_filters && \
        filter_maildir "$MAILDIRS/incoming" && \
        { [[ $DRYRUN == 1 ]] || update_notmuch; }
    exitcode=$?
}

cmd_send() {
    send ${option_params}
    exitcode=$?
}

cmd_peek() {
    peek ${option_params}
    exitcode=$?
}

cmd_smtp() {
