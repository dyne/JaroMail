# SEND
# this function should send all mails in outbox
send() {
    fn send $*
    setopt localoptions localtraps pipefail
    local -a queue_outbox
    local qbody res=0 result=0 interrupted=0 recipient_status held=0 outbox_item_held=0 anonymous anon_report
    [[ $DRYRUN = 1 ]] && { return 0 }

    lock "${MAILDIRS}/outbox" || return $?
    # Keep the framework's global signal cleanup from clearing lock ownership
    # before this function's always block has released the outbox.
    trap 'interrupted=130; global_quit=1' INT
    trap 'interrupted=143; global_quit=1' TERM
    trap 'interrupted=129; global_quit=1' HUP
    {
    queue_outbox=("$MAILDIRS"/outbox/{new,cur}/*(.DN))
    if (( ${#queue_outbox} == 0 )); then
        notice "Outbox is empty, no mails to send."
    fi

    for qbody in "${queue_outbox[@]}"; do
        res=0
        func "processing outbox queue: $qbody"
        # clean interrupt
        [[ $global_quit = 1 ]] && {
            error "User break requested, interrupting operation"
            res=130
            break
        }

        # Anonymous mail keeps its legacy transport, but changing an already
        # journaled SMTP item's From header must not bypass its recovery hold.
        anonymous=0
        if hdr "$qbody" | grep -i '^from: anon' > /dev/null; then
            if anon_report=$(outbox_state inspect "${qbody:h:t}/${qbody:t}") &&
                [[ "$anon_report" == *' eligible no-attempt' ]]; then anonymous=1; fi
        fi
        if (( anonymous )); then

            ztmp
            anoncfg=$ztmpfile

            sysread -o 1 <<EOF > "$anoncfg"
REMAIL		n
POOLSIZE	0
SENDPOOLTIME	0m
RATE		100

PGPREMPUBASC	/var/lib/mixmaster/used-stats/pubring.asc
PUBRING		/var/lib/mixmaster/used-stats/pubring.mix
TYPE1LIST	/var/lib/mixmaster/used-stats/rlist.txt
TYPE2REL	/var/lib/mixmaster/used-stats/mlist.txt
TYPE2LIST	/var/lib/mixmaster/used-stats/type2.list

SENDMAIL=jaro -q smtp
ERRLOG=${MAILDIRS}/logs/mixmaster.log
VERBOSE=2

EOF

            notice "Sending out anonymous email via mixmaster"
            e_addr=()
            hdr $qbody | e_parse To
            hdr $qbody | e_parse Cc
            # cycle through recipients
            for _e in ${(k)e_addr}; do
                _n="${(v)e_addr[$_e]}"
                act "Sending to: $_n <$_e>"

                # parse subject line
                anonsubj=`hdr "$qbody" | awk '
/^Subject: / { for(i=2;i<=NF;i++) printf "%s ", $i }'`
                act "Subject: $anonsubj"

                # strip headers and send via mixmaster
                awk '
BEGIN { body=0 }
/^$/ { body=1 }
{ if(body==1) print $0 }
' "$qbody" \
    | mixmaster --config="$anoncfg" -m --to="$_e" --subject="$anonsubj"
                recipient_status=$?
                func "mixmaster returns $recipient_status"
                (( recipient_status == 0 )) || res=$recipient_status
            done

        else # normal send with msmtp
            if outbox_send_one "$qbody"; then res=0; else res=$?; fi
            held=$(( held + outbox_item_held ))
            (( interrupted == 0 )) || break
            (( res == 0 )) || result=$res
            continue
        fi

        # evaluate results
        (( interrupted == 0 )) || { res=$interrupted; break; }
        if [[ "$res" != "0" ]]; then
            result=$res
            error "Error sending mail, skipped"
        else
            notice "Mail sent succesfully"
            # whitelist those to whom we send mails
            hdr "$qbody" | learn recipient
            if printfile "$qbody" | deliver sent; then
                command rm -- "$qbody" || result=1
            else
                result=1
            fi
        fi

    done
    (( held == 0 )) || warning "$held outbox item(s) held; delivery requires reconciliation"

    } always {
        unlock "$MAILDIRS/outbox" || result=1
        unset password
        smtp_keep_password=0
    }

    (( interrupted == 0 )) || return $interrupted
    (( res == 0 )) || result=$res
    return $result
}

