lock() {
    fn "lock $*"
    local _file="$1" dotlock res
    # can't use ckreq as that returns error on file empty
    [[ -r "$_file" ]] || {
        error "cannot lock, file not existing: $_file"
        return 1 }

    if helper.isfound dotlock; then
        dotlock=`command -v dotlock`
    else
        dotlock="${WORKDIR}/bin/dotlock"
    fi

    "${dotlock}" -r 0 "$_file"
    res=$?
    case $res in
	1) error "Cannot lock non existing file: $_file"
	    return 1 ;;
	3) error "Locked file in use: $_file"

	    return 3 ;;

	5) error "Lock is impossible on: $_file"
	    return 5 ;;
	# success
	0) if ! print -r -- "$$" > "$_file.pid"; then
                "${dotlock}" -u "$_file"
                return 1
            fi
	    return 0 ;;

	*) error "Unknown error locking: $res"
	    return 1 ;;
    esac
}

newlock() { # lock file, create if not existing
    fn "newlock $*"
    local _file="$1"

    touch "$_file" && chmod 600 "$_file" || return 1
    lock "$_file"
}

pidcheck() { # check if lock belongs to us
    fn "pidcheck $@"
    local _pid="$1" lockpid
    [[ -r "${_pid}.pid" ]] || return 1
    lockpid="$(cat "${_pid}.pid")" || return 1
    [[ "$lockpid" == "$$" ]] || {
        error "Refusing to unlock another process's lock: $_pid"
        return 3
    }
    return 0
}

unlock() {
    fn "unlock $*"
    local _file="$1" dotlock
    # can't use ckreq as that returns error on file empty
    [[ -r "$_file" ]] || {
        error "cannot unlock, file not existing: $_file"
        return 1 }

    pidcheck "$_file"
    [[ $? = 0 ]] || { return 1 }
    
    if helper.isfound dotlock; then
        dotlock="$(command -v dotlock)"
    else
        dotlock="${WORKDIR}/bin/dotlock"
    fi
    # Remove our marker while exclusion is still held. A new owner must not
    # have its marker removed after we release the dotlock.
    command rm -f -- "${_file}.pid" || return 1
    if ! "${dotlock}" -u "$_file"; then
        print -r -- "$$" > "${_file}.pid"
        error "Unable to unlock: $_file"
        return 1
    fi
    return 0
}

unlink() { # delete a file that we are locking
    fn "unlink $*"
    local _file="$1"
    # can't use ckreq as that returns error on file empty
    [[ -r "$_file" ]] || {
        error "cannot unlock, file not existing: $_file"
        return 1 }

    unlock "$_file" || return 1
    ${=rm} "$_file"
    func "$_file removed"
}
