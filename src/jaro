PROGRAM=jaro-mail
JAROMAILEXEC=$0

# default permission on files
umask 066

# honor quiet and debug flags as early as possible
if [[ ${@} == *-q* ]]; then QUIET=1; fi
if [[ ${@} == *-D* ]]; then DEBUG=1; fi

script_dir="${JAROMAILEXEC:A:h}"
bootstrap_path="${script_dir}/zlibs/bootstrap"
[[ -r "${bootstrap_path}" ]] || bootstrap_path="${script_dir}/../zlibs/bootstrap"
[[ -r "${bootstrap_path}" ]] || bootstrap_path="${script_dir}/../src/zlibs/bootstrap"
jaro_early_command() {
    local wanted="$1"
    shift
    while (( $# )); do
        case "$1" in
            -a|-l|--account|--list) (( $# >= 2 )) || return 1; shift 2 ;;
            --) shift; break ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    [[ ${1:-} == "$wanted" ]]
}
if [[ "${1:-}" == api ]]; then
    [[ "$#" == 2 && "$2" == --stdio ]] || {
        print -u2 -- 'usage: jaro api --stdio'
        exit 2
    }
    source "$bootstrap_path" doctor >&2 || exit $?
    exec python3 -I -B "$WORKDIR/api/stdio.py" "$WORKDIR" "$MAILDIRS"
fi
if [[ "${1:-}" == replay-record ]]; then
    shift
    source "$bootstrap_path" doctor || exit $?
    exec python3 -I "$WORKDIR/profile/replay.py" "$MAILDIRS" "$@"
fi
if [[ "${1:-}" == stats0 ]]; then
    shift
    (( $# == 1 )) || exit 2
    source "${bootstrap_path:h}/stats" || exit $?
    stats_records "$1"
    exit $?
fi
if [[ "${1:-}" == maildir ]]; then
    shift
    source "$bootstrap_path" doctor || exit $?
    exec python3 -I "$WORKDIR/maildir/operations.py" "$MAILDIRS" "$@"
fi
if [[ "${1:-}" == (account|group) ]]; then
    profile_kind="$1"
    shift
    source "$bootstrap_path" doctor || exit $?
    profile_dir="$ACCOUNTS"
    [[ "$profile_kind" == account ]] || profile_dir="$MAILDIRS/Groups"
    exec python3 -I "$WORKDIR/profile/records.py" "$profile_kind" "$WORKDIR" "$profile_dir" "$@"
fi
if [[ "${1:-}" == policy ]]; then
    shift
    source "$bootstrap_path" doctor || exit $?
    if [[ "$#" == 1 && "$1" == default-profile ]]; then
        exec "$WORKDIR/bin/jaro-filter-compile" --default-profile
    fi
    exec python3 -I "$WORKDIR/filter/candidate.py" "$WORKDIR" "$MAILDIRS" "$ACCOUNTS" "$@"
fi
if [[ "${1:-}" == contacts ]]; then
    shift
    source "$bootstrap_path" doctor || exit $?
    [[ -d "$MAILDIRS" ]] || exit 1
    contact_helper="$WORKDIR/bin/jaro-contact-records"
    [[ -x "$contact_helper" ]] || contact_helper="$WORKDIR/../build/gnu/cmake/jaro-contact-records"
    "$contact_helper" "$MAILDIRS" "$@" || exit $?
    if [[ "$1" == (put|delete) && "$2" == (allow|block) ]]; then
        "$WORKDIR/bin/jaro-filter-compile" --root "$MAILDIRS" --accounts-dir "$ACCOUNTS" || {
            print -u2 -- 'contacts: edit committed; policy refresh failed'
            exit 3
        }
    fi
    exit 0
fi
if jaro_early_command dedup "$@"; then
    source "${bootstrap_path:h}/dedup" || exit 1
    dedup_cli "$bootstrap_path" "$@"
    exit $?
fi
if jaro_early_command snapshot "$@"; then
    source "${bootstrap_path:h}/snapshot" || exit 1
    snapshot_cli "$bootstrap_path" "$@"
    exit $?
fi
# Doctor must also work when version metadata or the normal framework is absent.
if jaro_early_command doctor "$@"; then
    [[ -r "${bootstrap_path:h}/doctor" ]] || {
        print -u2 -- 'doctor: diagnostic module missing; reinstall Jaromail'
        exit 2
    }
    source "${bootstrap_path:h}/doctor" || exit 2
    doctor_cli "$bootstrap_path" "$@"
    exit $?
fi
source "${bootstrap_path:h}/version" || exit 1
jaromail_version "$script_dir" || exit $?
VERSION="$REPLY"
if (( $# == 1 )) && [[ $1 == -v || $1 == --version ]]; then
    print -r -- "Jaro Mail v${VERSION}"
    exit 0
fi

jaro_release_update() {
    local arg prefix installer="${script_dir}/install-release.sh"
    local preview=0 seen=0
    for arg in "$@"; do
        case "$arg" in
            update) (( ! seen )) || return 2; seen=1 ;;
            -n|--dry-run) preview=1 ;;
            -q|--quiet|-D|--debug|--) ;;
            -h|--help)
                print -r -- 'Usage: jaro [-n] update'
                print -r -- 'Install the latest stable Linux release into this installation.'
                return 0 ;;
            *)
                print -u2 -r -- 'Usage: jaro [-n] update'
                print -u2 -r -- 'For mail profiles, use jaro fresh [MAIL_ROOT].'
                return 2 ;;
        esac
    done
    prefix="${script_dir:h:h:h}"
    if [[ "$script_dir" != "$prefix/share/jaromail/bin" ||
          ! -x "$prefix/bin/jaro" || ! -r "$installer" ]]; then
        print -u2 -r -- 'jaro update requires an installed Linux release layout. See the installation guide.'
        return 2
    fi
    if (( preview )) || [[ ${DRYRUN:-0} == 1 ]]; then
        print -r -- "Would check for a newer stable JaroMail release and install it in $prefix."
        return 0
    fi
    exec bash "$installer" --prefix "$prefix" --installed-version "$(<"$script_dir/../VERSION")"
}

if jaro_early_command update "$@"; then
    jaro_release_update "$@"
    exit $?
fi
# Select the command before bootstrap can initialize files or touch a keyring.
# Skip option values so `queue outbox` and account names never become a route.
jaro_outbox_route() {
    while (( $# )); do
        case "$1" in
            -a|-l|--account|--list) (( $# >= 2 )) || return 1; shift 2 ;;
            --) shift; break ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    [[ "$1" == outbox && $# -gt 1 ]] || return 1
    return 0
}
if jaro_outbox_route "$@"; then
    source "${bootstrap_path:h}/outbox" || exit 1
    outbox_needs_runtime=0
    outbox_cli "$bootstrap_path" "$@"
    outbox_status=$?
    (( outbox_status == 0 )) || exit $outbox_status
    if (( outbox_needs_runtime )); then
        # Framework typeset initialization requires top-level source scope.
        source "$bootstrap_path" source || exit $?
        outbox_execute
        exit $?
    fi
    exit 0
fi
# Materialize profile defaults after the normal parser has resolved the
# contact command and dry-run flag.
jaro_defer_profile_defaults=1
source "${bootstrap_path}" || {
    print -u2 "Cannot source bootstrap module: ${bootstrap_path}"
    exit 1
}
unset jaro_defer_profile_defaults


usage() {
    cat <<EOF | more
Jaro Mail $VERSION - your humble and faithful electronic postman

Synopsis: jaro [options] [command] [command-options]

Main commands:

 fetch  download unread emails from [account]
 send   send all mails queued in the outbox
 outbox inspect held messages and explicitly retry or archive an ID
 doctor diagnose local setup offline without changing files
 snapshot create, verify or restore an independent message copy
 dedup  remove byte-identical copies in Maildir priority order
 peek   look into the [account] mailbox without downloading
 serve  run localhost IMAP over local maildirs (single-user)
 index  build or update the search index for all maildirs
 search search maildirs or addressbook for expressions
 update download and install the latest stable JaroMail release

Options:

 -a     use a particular [account] instead of default
 -l     select a contact list by exact name, 'allow' is default
 -n     dry run, show operations without executing them
 -q     run quietly without printing information
 -D     print debugging information at runtime
 -v     version information for this tool
 -h     print this help

== Contact commands (use -l to select a list)
a pipe | in front indicate they take an email body from stdin

 abook    edit the [abook] using the console editor
 list     list contacts in the selected list
 addr     search contacts by name, mailbox, nickname, or notes
 export   write the selected list as vCard records

 extract  list addresses of all recipients or senders found in:
          maildir, search expr, vcard, gnupg keyring or pubkey

|import   read address list from stdin into addressbook or group
          (the output of extract commands can be piped to import)


== Operational commands (use -a to indicate [account])

 fetch    downloads emails locally from [account]

 send     send all outbox/ queue via the [account]'s smtp

 outbox list
          read-only IDs, delivery states and classified outcomes
 outbox submit
          enqueue or look up frozen SMTP envelopes from standard input
 outbox send ID --expect STATE
          send one eligible or prepared envelope
 outbox retry ID --confirm-duplicate
          retry only this held ID; previously accepted mail may duplicate
 outbox archive ID
          finish local sent copy after externally verifying delivery; no SMTP

 imap shell
          browse remote folders, page headers, measure sizes and download archives
          type help at the imap> prompt or see man jaro for a worked session

 peek     interactive connection to an [account]'s imap folder
          (takes folder names as argument, default is INBOX)

 passwd   set [account]'s passwords in the OS native keyring
 wizard   interactive setup for a new account configuration
 doctor [--json]
          read-only setup checks; use -a to select an account
          --json emits schema version 1 with stable check IDs

|queue    read a mail from stdin and queue it in outbox/ for sending

|smtp     read a mail from stdin and send it via [accounts]'s smtp


== Machine-readable profile commands
 account, group   list, get or update native profile records by revision
 contacts         read and edit books or multi-address contacts by revision
 maildir          browse, preview and apply occurrence-based changes
 policy           preview and apply native rule, alias or mailbox mapping edits with a sample
 replay-record    read one named or last replay with its producer
 stats0           count a NUL-delimited selection by folder, name, email or domain
 See docs/command-contracts.md for request and response formats.

== Storage commands

 open     open a maildir folder (can use -R for read-only)

 backup   move search results from a maildir to another one
          (string or date range matches, can use -n for dry-run)

 dedup [--scratch-dir DIR] [--] MAILDIR...
          keep the first exact copy, or use -n to preview each keep/remove pair

 snapshot create DEST
          copy message bytes and flags to a new private snapshot
          stop all mail writers first; accounts and credentials are excluded
 snapshot verify SNAPSHOT
          check the complete manifest and every captured message
 snapshot restore SNAPSHOT DEST
          restore into a fresh empty mail root; outbox is held for inspection

 merge    merge a source maildir into destination, then delete source

 fresh          regenerate filters and refresh the search index
 fresh-filters  regenerate local filters and the portable Sieve script
 fresh-search   refresh the existing search index
 sieve          regenerate Sieve after any required filter migration

 sieve-import FILE
          import a Jaromail-generated Sieve file into Filters.txt,
          Aliases.txt and the allow and block lists in contacts.sqlite

 filter   process a maildir distributing emails according to Filters.txt
          (if none specified, processes incoming/ - called by fetch)
          --explain renders native decisions without moving messages
          --compare FILE compares retained JLC1 legacy observations
          JARO_FILTER_ENGINE=sieve (legacy and native are compatibility names)

For a complete introductory documentation, see the User Manual (PDF)
Website on <http://dyne.org/software/jaro-mail>
Report bugs to <https://github.com/dyne/JaroMail/issues>
EOF
}

typeset -A subcommands_opts

main() {
	local exitcode=0 handler_status
	# zuper option parser

    option_main=(a: -account=a l: -list=l q -quiet=q D -debug=D h -help=h v -version=v n -dry-run=n f -force=f)

    option_subcommands[__empty]="R -readonly=R"
    option_subcommands[compose]=""
    option_subcommands[queue]=""
    option_subcommands[fetch]=""
    option_subcommands[send]=""
    option_subcommands[peek]="R -readonly=R"
    option_subcommands[serve]=""
    option_subcommands[open]="R -readonly=R"

    option_subcommands[help]=""

    option_subcommands[fresh]=""
    option_subcommands[fresh-filters]=""
    option_subcommands[fresh-search]=""
    option_subcommands[sieve]=""
    option_subcommands[sieve-import]="L -legacy-generated=L"

    option_subcommands[stat]=""

    option_subcommands[index]=""
    option_subcommands[search]=""

    option_subcommands[alot-config]=""
    option_subcommands[alot]=""
    option_subcommands[notmuch-config]=""
    option_subcommands[notmuch]=""

    option_subcommands[addr]=""
    option_subcommands[learn]=""
    option_subcommands[forget]=""

    option_subcommands[complete]=""
    option_subcommands[isknown]=""

    option_subcommands[list]=""
    option_subcommands[extract]=""
    option_subcommands[parse]=""
    option_subcommands[header]=""
    option_subcommands[headers]=""

    option_subcommands[import]=""
    option_subcommands[export]=""
    option_subcommands[vcard]=""
    option_subcommands[abook]=""
	option_subcommands[wizard]=""

    option_subcommands[vim]=""
    option_subcommands[edit]=""
    option_subcommands[preview]=""

    option_subcommands[replay]=""

    option_subcommands[remember]=""

    option_subcommands[backup]=""
    option_subcommands[rmdupes]=""
    option_subcommands[merge]=""
    option_subcommands[filter]="e -explain=e c: -compare:=c"
    option_subcommands[deliver]=""

    option_subcommands[passwd]=""
    option_subcommands[askpass]=""

    option_subcommands[source]=""

    option_subcommands[isonline]=""

    option_subcommands[init]=""

    option_subcommands[imap]=""

    option_subcommands[smtp]=""

    option_subcommands[crypt]=""
    option_subcommands[cryptsign]=""

    option_subcommands[isml]=""
    option_subcommands[ismd]=""

	# Import takes exactly one file. The shared option library declares unique
	# arrays; retain repeated positional arguments so validation can reject them.
	if (( ${@[(Ie)sieve-import]} )); then
		typeset +U option_params
		local import_arg
		for import_arg in "$@"; do
			[[ -n $import_arg ]] || { error "Empty sieve-import argument"; return 2; }
		done
	fi
	option.parse "$@" || return 2
    local contact_preview=0
    case "$subcommand" in
        learn|import|abook)
            if [[ $DRYRUN == 1 ]] || option.is_set -n; then
                contact_preview=1
            fi
            ;;
    esac
    (( contact_preview )) || bootstrap_profile_defaults "$@" || return $?

    if [[ $subcommand == filter ]]; then
        local filter_arg
        for filter_arg in "$@"; do
            [[ -n $filter_arg ]] || { error "Empty filter argument"; return 2; }
        done
    fi
	func "subcommand: $subcommand"

    func "configure accounts in $ACCOUNTS"
	func "notmuch config in $MAILDIRS/notmuch-config"
	func "sieve filters in $MAILDIRS/Filters.sieve"

	# print out version
    if option.is_set -v; then
        print -r -- "Jaro Mail v${VERSION}"
        return 0
    fi

    { option.is_set -a } && { account=`option.value -a` }
    { option.is_set -l } && { list=$(option.value -l); contact_list_explicit=1 }
    { option.is_set -h } && { usage; return 0 }
    { option.is_set -v } && {
        cat $JAROMAILEXEC | awk 'BEGIN { v=1 } !/^#/ { exit }'
        return 0
    }
    { option.is_set -q } && { QUIET=1 }
    { option.is_set -D } && { DEBUG=1; QUIET=0
    func "All debug messages ON" }
    { option.is_set -n } && { DRYRUN=1
    act "Dry run, show operations without executing them." }
    { option.is_set -R } && { muttflags+=" -R " }
    { option.is_set -f } && { FORCE=1 }

    check_bin "$subcommand" || return $?

    # clean up options from param
    # PARAM=(${PARAM// -? /})

    case "$subcommand" in

    compose) cmd_compose
            ;;

    queue)  cmd_queue
            ;;

    fetch) 	cmd_fetch
			;;

    send)   cmd_send
            ;;

    peek)   cmd_peek
            ;;
    serve)  cmd_serve
            ;;

    remember) cmd_remember
        ;;

    replay) cmd_replay ;;

    init) cmd_init ;;

    fresh) cmd_fresh ;;
    fresh-filters|sieve) cmd_fresh_filters ;;
    fresh-search) cmd_fresh_search ;;

    sieve-import) cmd_sieve_import ;;

    help) cmd_help ;;

    index) cmd_index ;;

    search) cmd_search ;;

	alot-config) cmd_alot_config ;;

    alot) cmd_alot ;;

	notmuch-config) cmd_notmuch_config ;;
    notmuch) cmd_notmuch ;;

    addr|list) cmd_addr_list ;;

    complete) cmd_complete ;;

    isknown) cmd_isknown ;;

    learn)  cmd_learn ;;

    import) cmd_import ;;

    "export") cmd_export ;;

    abook)  cmd_abook ;;

	wizard) cmd_wizard ;;

    stat*) cmd_stat ;;

    edit|vim) cmd_edit_vim ;;
    open) cmd_open ;;
    preview) cmd_preview ;;

    mkdir) cmd_mkdir ;;

    merge) cmd_merge ;;

    rmdupes) cmd_rmdupes ;;

    backup) backup "${option_params[@]}" ;;

    filter) cmd_filter ;;

    deliver) cmd_deliver ;;

    passwd) cmd_passwd ;;

    # cert)    cert ${option_params} ;; # was checking is_online

    isonline) cmd_isonline ;;

    'source')   return 0 ;;

    askpass) cmd_askpass ;;

    imap) cmd_imap ;;

    extract|parse) cmd_extract_parse ;;

    header|headers) cmd_header_headers ;;

    smtp) cmd_smtp ;;

    isml) cmd_isml ;;

    ismd) cmd_ismd ;;

    __empty) cmd_empty ;;

	__unknown:*) cmd_unknown "$@" ;;
    esac

    handler_status=$?
    (( handler_status == 0 )) || return $handler_status
    return $exitcode
}


main "$@"
# endgame NOERRORS
